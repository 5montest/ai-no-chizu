---
import { getCollection } from 'astro:content';
import GuideIcon from '../../components/GuideIcon.astro';
import GuideImage from '../../components/GuideImage.astro';
import SourceList from '../../components/SourceList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import glossary from '../../data/glossary.json';
import curriculum from '../../data/curriculum.json';
import { withBase } from '../../lib/site.mjs';

export async function getStaticPaths() {
  return glossary.terms.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

const { term } = Astro.props;
const categoryIcons: Record<string,string> = { basic: 'book', llm: 'chip', learning: 'layers', architecture: 'network', application: 'tools', local: 'terminal', evaluation: 'chart', business: 'coins', security: 'shield', practice: 'check' };
const termImages: Record<string,string> = { 'context-window': 'context-memory', 'context-compaction': 'context-memory', 'machine-learning': 'learning-inference', inference: 'learning-inference', precision: 'evaluation-errors', recall: 'evaluation-errors', 'confusion-matrix': 'evaluation-errors', 'false-positive': 'evaluation-errors', 'false-negative': 'evaluation-errors', multimodal: 'multimodal-business', vlm: 'multimodal-business', skill: 'extension-layers', mcp: 'extension-layers', hook: 'extension-layers', plugin: 'extension-layers', quantization: 'local-memory', ram: 'local-memory' };
const category = glossary.categories.find((c) => c.id === term.category);
const related = term.related
  .map((slug: string) => glossary.terms.find((t) => t.slug === slug))
  .filter(Boolean);
const chapters = term.chapters
  .map((id: string) => curriculum.chapters.find((c) => c.id === id))
  .filter(Boolean);

const entries = await getCollection('chapters');
const backlinks = entries
  .filter((entry) => entry.data.glossary.includes(term.slug))
  .sort((a, b) => Number(a.data.chapter) - Number(b.data.chapter) || a.data.order - b.data.order);

// 前後の用語。並び順は一覧ページと同じ「読みの五十音順」にする。
// 一覧と詳細で順番が違うと、前後ナビが読者の期待とずれる。
const toHiragana = (value: string): string =>
  String(value ?? '')
    .normalize('NFKC')
    .replace(/[\u30a1-\u30f6]/g, (char) => String.fromCharCode(char.charCodeAt(0) - 0x60));
const sortedTerms = [...glossary.terms].sort((a, b) => {
  const keyA = toHiragana(a.reading);
  const keyB = toHiragana(b.reading);
  return keyA.localeCompare(keyB, 'ja') || a.term.localeCompare(b.term, 'ja');
});
const currentIndex = sortedTerms.findIndex((item) => item.slug === term.slug);
const prevTerm = currentIndex > 0 ? sortedTerms[currentIndex - 1] : null;
const nextTerm =
  currentIndex >= 0 && currentIndex < sortedTerms.length - 1 ? sortedTerms[currentIndex + 1] : null;
---

<BaseLayout title={`${term.term}｜用語辞典`} description={term.short}>
  <div class="page">
    <div class="shell">
      <div class="term-page">
        <Breadcrumb
          items={[
            { label: '用語辞典', href: withBase('/glossary/') },
            { label: term.term },
          ]}
        />

        <header class="term-hero">
          <p class="term-hero__category"><GuideIcon name={categoryIcons[term.category] ?? 'book'} size={22} /> {category?.label ?? '用語'}</p>
          <h1>{term.term}</h1>
          <p class="term-hero__reading">{term.reading}</p>
          <p class="term-hero__short">{term.short}</p>
        </header>
        {termImages[term.slug] && <GuideImage name={termImages[term.slug]} />}
        {term.example && <section class="term-example"><GuideIcon name={categoryIcons[term.category] ?? 'book'} /><div><h2>仕事や学習での例</h2><p>{term.example}</p></div></section>}

        <section class="term-section">
          <h2>厳密には</h2>
          <p>{term.strict}</p>
        </section>

        <section class="term-section">
          <div class="callout callout--myth">
            <h2 class="callout__label">よくある誤解</h2>
            <p>{term.myth}</p>
          </div>
        </section>

        {chapters.length > 0 && (
          <section class="term-section">
            <h2>関連する章</h2>
            <div class="chapter-chips">
              {chapters.map((chapter: any) =>
                chapter.status === 'published' ? (
                  <a class="chip" href={withBase(`/chapters/${chapter.id}/`)}>
                    <span class="chip__no">{chapter.id}</span>
                    {chapter.shortTitle}
                  </a>
                ) : (
                  <span class="chip chip--planned">
                    <span class="chip__no">{chapter.id}</span>
                    {chapter.shortTitle}（準備中）
                  </span>
                ),
              )}
            </div>
          </section>
        )}

        {backlinks.length > 0 && (
          <section class="term-section">
            <h2>この用語が出てくるページ</h2>
            <ul class="backlink-list">
              {backlinks.map((entry) => {
                const [chapterId, slug] = entry.id.split('/');
                const chapterTitle =
                  curriculum.chapters.find((c) => c.id === chapterId)?.shortTitle ?? '';
                return (
                  <li>
                    <a href={withBase(`/chapters/${chapterId}/${slug}/`)}>{entry.data.title}</a>
                    <span class="meta">第{chapterId}章 {chapterTitle}</span>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {related.length > 0 && (
          <section class="term-section">
            <h2>関連用語</h2>
            <div class="chapter-chips">
              {related.map((item: any) => (
                <a class="chip" href={withBase(`/glossary/${item.slug}/`)}>
                  {item.term}
                </a>
              ))}
            </div>
          </section>
        )}

        <SourceList sources={term.sources.length ? term.sources : [...new Map(backlinks.flatMap(entry => entry.data.sources).filter(source => source.url).map(source => [source.url, source])).values()].slice(0,3)} heading={term.sources.length ? '定義の参照資料' : '関連章の参考資料'} />
        <nav class="page-nav page-nav--three" aria-label="用語の前後">
          {prevTerm && (
            <a href={withBase(`/glossary/${prevTerm.slug}/`)} rel="prev">
              <span class="dir">前の用語</span>
              <span class="title">{prevTerm.term}</span>
            </a>
          )}
          <a href={withBase('/glossary/')}>
            <span class="dir">用語辞典</span>
            <span class="title">用語一覧に戻る</span>
          </a>
          {nextTerm && (
            <a href={withBase(`/glossary/${nextTerm.slug}/`)} rel="next">
              <span class="dir">次の用語</span>
              <span class="title">{nextTerm.term}</span>
            </a>
          )}
        </nav>
      </div>
    </div>
  </div>

  <style>
    /* 前へ／一覧／次へ の3点ナビ。真ん中は一覧に戻るリンクとして中央に置く。 */
    .page-nav.page-nav--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .page-nav.page-nav--three a[rel='prev'] {
      text-align: left;
      align-items: flex-start;
    }

    .page-nav.page-nav--three a:not([rel]) {
      text-align: center;
      align-items: center;
    }

    .page-nav.page-nav--three a[rel='next'] {
      text-align: right;
      align-items: flex-end;
    }

    @media (max-width: 640px) {
      .page-nav.page-nav--three {
        grid-template-columns: 1fr;
      }

      .page-nav.page-nav--three a[rel='prev'],
      .page-nav.page-nav--three a:not([rel]),
      .page-nav.page-nav--three a[rel='next'] {
        text-align: left;
        align-items: flex-start;
      }
    }
  </style>
</BaseLayout>
