---
import GuideIcon from '../../components/GuideIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import glossary from '../../data/glossary.json';
import { withBase } from '../../lib/site.mjs';

const categoryIcons: Record<string,string> = { basic: 'book', llm: 'chip', learning: 'layers', architecture: 'network', application: 'tools', local: 'terminal', evaluation: 'chart', business: 'coins', security: 'shield', practice: 'check' };
const confusingPairs = [
  ['学習と推論', 'machine-learning', 'inference'], ['モデルとハーネス', 'llm', 'harness'],
  ['適合率と再現率', 'precision', 'recall'], ['追加学習と保存', 'fine-tuning', 'data-retention'],
  ['音声認識と音声合成', 'stt', 'tts'], ['重みの公開と利用条件', 'open-weights', 'license'],
];
const categories = glossary.categories;
const terms = [...glossary.terms].sort((a, b) => a.reading.localeCompare(b.reading, 'ja'));
const labelOf = Object.fromEntries(categories.map((c) => [c.id, c.label]));

// 読みの頭で「あ行／か行…／英字」に分ける。カタカナの読みはひらがなに直してから判定する。
const toHiragana = (value: string): string =>
  String(value ?? '')
    .normalize('NFKC')
    .replace(/[\u30a1-\u30f6]/g, (char) => String.fromCharCode(char.charCodeAt(0) - 0x60));

const rowOf = (reading: string): string => {
  const first = toHiragana(reading).charAt(0);
  if ('あいうえお'.includes(first)) return 'あ行';
  if ('かきくけこがぎぐげご'.includes(first)) return 'か行';
  if ('さしすせそざじずぜぞ'.includes(first)) return 'さ行';
  if ('たちつてとだぢづでど'.includes(first)) return 'た行';
  if ('なにぬねの'.includes(first)) return 'な行';
  if ('はひふへほばびぶべぼぱぴぷぺぽ'.includes(first)) return 'は行';
  if ('まみむめも'.includes(first)) return 'ま行';
  if ('やゆよ'.includes(first)) return 'や行';
  if ('らりるれろ'.includes(first)) return 'ら行';
  if ('わをん'.includes(first)) return 'わ行';
  return '英字・その他';
};

const ROW_ORDER = ['あ行', 'か行', 'さ行', 'た行', 'な行', 'は行', 'ま行', 'や行', 'ら行', 'わ行', '英字・その他'];

// 五十音順。読みはひらがな・カタカナが混ざっているので、ひらがなに直したキーで並べる。
const sortedTerms = [...glossary.terms].sort((a, b) => {
  const keyA = toHiragana(a.reading);
  const keyB = toHiragana(b.reading);
  return keyA.localeCompare(keyB, 'ja') || a.term.localeCompare(b.term, 'ja');
});
const rows = ROW_ORDER.map((label) => ({
  label,
  terms: sortedTerms.filter((term) => rowOf(term.reading) === label),
})).filter((row) => row.terms.length > 0);
---

<BaseLayout title="用語辞典" description={`AI・LLM・エージェント・評価に関する${terms.length}語を、「ひとこと」「厳密には」「よくある誤解」で整理した用語辞典。`}>
  <div class="page">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href={withBase('/')}>ホーム</a>
        <span aria-hidden="true">/</span>
        <span>用語辞典</span>
      </nav>

      <div class="section-head section-head--left page-head">
        <h1>用語辞典</h1>
        <p>
          ひとことで言うと何か。厳密には何が違うのか。どこで誤解されやすいのか。
          AIの仕組みや業務利用に関わる{terms.length}語を、3つの層で定義しています。
        </p>
      </div>

      <section class="term-pairs" aria-labelledby="term-pairs-title"><h2 id="term-pairs-title">混同しやすい言葉から探す</h2><div>{confusingPairs.map(([label,a,b]) => <p><span>{label}</span><a href={withBase(`/glossary/${a}/`)}>{terms.find(t => t.slug === a)?.term}</a><span aria-hidden="true"> / </span><a href={withBase(`/glossary/${b}/`)}>{terms.find(t => t.slug === b)?.term}</a></p>)}</div></section>
      <div class="glossary-tools">
        <label class="search-field">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.2"></circle>
            <path d="m12.6 12.6 4 4"></path>
          </svg>
          <span class="sr-only">用語を検索</span>
          <input type="search" placeholder="用語・読み・説明から検索" data-glossary-search autocomplete="off" />
        </label>
        <div class="filter-chips" role="group" aria-label="カテゴリで絞り込む">
          <button class="filter-chip is-active" type="button" data-cat="all">すべて</button>
          {categories.map((category) => (
            <button class="filter-chip" type="button" data-cat={category.id}>{category.label}</button>
          ))}
        </div>
      </div>

      <p class="glossary-count" data-glossary-count aria-live="polite">{terms.length}語を表示中</p>

      <div data-glossary-groups>
        {rows.map((row) => (
          <section class="glossary-row" data-glossary-row>
            <h2 class="glossary-row__head">{row.label}</h2>
            <div class="glossary-grid">
              {row.terms.map((term) => (
                <a
                  class="term-card"
                  href={withBase(`/glossary/${term.slug}/`)}
                  data-term
                  data-cat={term.category}
                  data-search={`${term.term} ${term.reading} ${term.aliases.join(' ')} ${term.short} ${term.strict} ${term.example}`}
                >
                  <span class="term-card__cat"><GuideIcon name={categoryIcons[term.category] ?? 'book'} size={18} /> {labelOf[term.category]}</span>
                  <span class="term-card__term">{term.term}</span>
                  <span class="term-card__reading">{term.reading}</span>
                  <p class="term-card__short">{term.short}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
      <p class="empty-state" data-glossary-empty hidden>
        条件に一致する用語がありません。別の言葉で試してください。
      </p>
    </div>
  </div>

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-glossary-search]');
    const chips = [...document.querySelectorAll<HTMLButtonElement>('button[data-cat]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-term]')];
    const rows = [...document.querySelectorAll<HTMLElement>('[data-glossary-row]')];
    const count = document.querySelector<HTMLElement>('[data-glossary-count]');
    const empty = document.querySelector<HTMLElement>('[data-glossary-empty]');
    let category = 'all';

    const normalize = (value: string) =>
      value.normalize('NFKC').toLowerCase().replace(/\s+/g, ' ').trim();

    function apply() {
      const q = normalize(input?.value ?? '');
      let visible = 0;
      for (const card of cards) {
        const matchesCat = category === 'all' || card.dataset.cat === category;
        const matchesText = !q || normalize(card.dataset.search ?? '').includes(q);
        const show = matchesCat && matchesText;
        card.hidden = !show;
        if (show) visible += 1;
      }
      // 行見出しは、その行に1枚でも表示中のカードがあるときだけ出す。
      for (const row of rows) {
        const shown = [...row.querySelectorAll<HTMLElement>('[data-term]')].filter(
          (card) => !card.hidden,
        ).length;
        row.hidden = shown === 0;
      }
      if (count) count.textContent = `${visible}語を表示中`;
      if (empty) empty.hidden = visible !== 0;
    }

    input?.addEventListener('input', apply);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        category = chip.dataset.cat ?? 'all';
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        apply();
      });
    });
  </script>

  <style>
    /* 読みの行見出し。121語をスクロールで探せるよう、あ行・か行…で区切る。 */
    .glossary-row {
      margin: 0 0 1.5rem;
    }

    .glossary-row__head {
      margin: 0 0 0.6rem;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink-soft);
      font-size: 0.9375rem;
      font-weight: 700;
    }

    /* カードに読みを添える。並び順の意味が分かるようにする。 */
    .term-card__reading {
      display: block;
      margin-top: 0.1rem;
      color: var(--ink-mute);
      font-size: 0.75rem;
      font-weight: 400;
      line-height: 1.5;
    }
  </style>
</BaseLayout>
