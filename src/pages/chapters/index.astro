---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import curriculum from '../../data/curriculum.json';
import { withBase } from '../../lib/site.mjs';

const entries = await getCollection('chapters');
const stats = new Map<string, { pages: number; minutes: number }>();
for (const entry of entries) {
  const current = stats.get(entry.data.chapter) ?? { pages: 0, minutes: 0 };
  current.pages += 1;
  current.minutes += entry.data.readingMinutes;
  stats.set(entry.data.chapter, current);
}
const publishedCount = curriculum.chapters.filter((c) => c.status === 'published').length;
const allPublished = publishedCount === curriculum.chapters.length;
---

<BaseLayout
  title="章一覧"
  description={`AIの地図の全${curriculum.chapters.length}章を、${curriculum.parts.length}つの部で一覧。第1章から順に読み進められます。`}
>
  <div class="page">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href={withBase('/')}>ホーム</a>
        <span aria-hidden="true">/</span>
        <span>章一覧</span>
      </nav>

      <div class="section-head section-head--left page-head">
        <h1>章一覧</h1>
        <p>
          基礎編（第1〜22章）で仕組みと考え方を学び、実践編（第23〜32章）で実際の製品を選んで使います。
          {curriculum.parts.length}つの部で構成し、各章は複数の短いページに分かれ、
          図・例・誤解しやすい点・クイズを含みます。
          {allPublished
            ? `全${curriculum.chapters.length}章を公開中です。`
            : `全${curriculum.chapters.length}章のうち${publishedCount}章を公開中で、準備中の章は公開時にここへ追加されます。`}
        </p>
      </div>

      <div class="contents">
        {curriculum.parts.map((part) => (
          <section aria-labelledby={`part-${part.id}`}>
            <div class="part__head">
              <span class="part__roman" aria-hidden="true">{part.roman}</span>
              <div>
                <h2 id={`part-${part.id}`}>
                  <span class="sr-only">第{part.roman}部</span>
                  {part.title}
                </h2>
                <p class="part__lead">{part.lead}</p>
              </div>
            </div>
            <ul class="chapter-list">
              {curriculum.chapters
                .filter((chapter) => chapter.part === part.id)
                .map((chapter) => {
                  const stat = stats.get(chapter.id);
                  return (
                    <li>
                      {chapter.status === 'published' ? (
                        <a class="chapter-row" href={withBase(`/chapters/${chapter.id}/`)}>
                          <span class="chapter-row__no">{chapter.id}</span>
                          <span>
                            <span class="chapter-row__title">{chapter.title}</span>
                            <span class="chapter-row__q">{chapter.question}</span>
                          </span>
                          <span class="chapter-row__meta">
                            {stat?.pages ?? 0}ページ・約{stat?.minutes ?? 0}分
                          </span>
                        </a>
                      ) : (
                        <div class="chapter-row chapter-row--planned">
                          <span class="chapter-row__no">{chapter.id}</span>
                          <span>
                            <span class="chapter-row__title">{chapter.title}</span>
                            <span class="chapter-row__q">{chapter.question}</span>
                          </span>
                          <span class="chapter-row__meta">準備中</span>
                        </div>
                      )}
                    </li>
                  );
                })}
            </ul>
          </section>
        ))}
      </div>

      <section class="section section--tight">
        <div class="callout callout--note">
          {allPublished ? (
            <>
              <p class="callout__label">読み進め方</p>
              <p>
                章は第1章から順に並び、前の章で使った言葉を前提に次の章が進みます。
                関心のある章から読む場合は、各ページ末尾のリンクから関連する章へ移れます。
              </p>
            </>
          ) : (
            <>
              <p class="callout__label">公開の進め方</p>
              <p>
                第1〜22章（基礎編）と、第23〜25章・第27〜32章（実践編）を公開しています。
                残りの実践編は、公式資料での確認と実習の検証が終わった章から順に追加します。
                準備中の章は一覧に残し、公開時に本文と実習を追加します。
              </p>
              <p>
                製品名から探したいときは<a href={withBase('/zukan/')}>AI図鑑</a>、
                手順から入りたいときは<a href={withBase('/practice/')}>実践編の入口</a>を使ってください。
              </p>
            </>
          )}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
