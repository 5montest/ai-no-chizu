---
import { getCollection, render } from 'astro:content';
import ArticleVisual from '../../../components/ArticleVisual.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Toc from '../../../components/Toc.astro';
import Quiz from '../../../components/Quiz.astro';
import SourceList from '../../../components/SourceList.astro';
import RelatedTerms from '../../../components/RelatedTerms.astro';
import PageNav from '../../../components/PageNav.astro';
import ReadingRoute from '../../../components/ReadingRoute.astro';
import ArticleSummary from '../../../components/ArticleSummary.astro';
import { optionalTechnicalChapters } from '../../../data/reading-paths';
import curriculum from '../../../data/curriculum.json';
import { withBase, SITE, BASE } from '../../../lib/site.mjs';
import { buildCourseOrder, neighbours, toNavItem } from '../../../lib/course-nav.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('chapters');
  return entries.map((entry) => {
    const [chapterId, slug] = entry.id.split('/');
    return {
      params: { chapter: chapterId, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const data = entry.data;
const [chapterId, slug] = entry.id.split('/');
const chapter = curriculum.chapters.find((c) => c.id === chapterId);
const { Content, headings } = await render(entry);

const siblings = (await getCollection('chapters'))
  .filter((e) => e.data.chapter === chapterId)
  .sort((a, b) => a.data.order - b.data.order);

const pages = siblings.map((e) => ({
  slug: e.id.split('/')[1],
  title: e.data.title,
  order: e.data.order,
}));

// 前後は章の中で閉じず、公開中の章をまたいで学習順につなぐ。
// 未公開の章は course-nav 側で除外されるので、存在しないページへは進まない。
const course = buildCourseOrder(await getCollection('chapters'), curriculum);
const position = neighbours(course, entry.id);
const prev = toNavItem(position?.prev, chapterId, BASE);
const next = toNavItem(position?.next, chapterId, BASE);
const indexInCourse = position?.current.indexInCourse ?? 0;
const totalInCourse = position?.current.totalInCourse ?? 0;
const indexInChapter = position?.current.indexInChapter ?? data.order;
const pagesInChapter = position?.current.pagesInChapter ?? siblings.length;

const levelLabel = { intro: '入門', intermediate: '中級', advanced: '発展' } as Record<string, string>;
---

<BaseLayout title={data.title} description={data.description} ogType="article">
  <div class="page">
    <div class="shell">
      <Breadcrumb
        items={[
          { label: '章一覧', href: withBase('/chapters/') },
          { label: `第${chapterId}章 ${chapter?.shortTitle ?? ''}`, href: withBase(`/chapters/${chapterId}/`) },
          { label: data.title },
        ]}
      />

      <div class="article-wrap">
        <div class="article-rail">
          <Sidebar chapterId={chapterId} currentPage={slug} pages={pages} />
          <Toc headings={headings} />
        </div>

        <article class="article-main">
          <ReadingRoute pageId={entry.id} />
          <div class="article-lead">
            <header class="article-head">
              <p class="article-head__chapter">
                <a href={withBase(`/chapters/${chapterId}/`)}>
                  第{chapterId}章 {chapter?.shortTitle}
                </a>
              </p>
              <h1>{data.title}</h1>
              <p class="article-head__desc">{data.description}</p>
              <dl class="article-head__meta">
                <div>
                  <dt>レベル</dt>
                  <dd>{levelLabel[data.level] ?? data.level}</dd>
                </div>
                <div>
                  <dt>読了</dt>
                  <dd>約{data.readingMinutes}分</dd>
                </div>
                <div>
                  <dt>この章</dt>
                  <dd>{pagesInChapter}ページ中{indexInChapter}</dd>
                </div>
                <div>
                  <dt>学習順</dt>
                  <dd>{totalInCourse}ページ中{indexInCourse}</dd>
                </div>
                <div>
                  <dt>{data.updated === SITE.published ? '公開' : '更新'}</dt>
                  <dd>{data.updated}</dd>
                </div>
              </dl>
            </header>

            {optionalTechnicalChapters.has(chapterId) && <p class="article-reading-note">仕組みや開発手順を詳しく扱うページです。業務で必要な範囲だけ先に読みたい場合は、<a href={withBase('/start/')}>学習ルート</a>で別の入口を選べます。</p>}
            <ArticleSummary lines={data.summary} />
          </div>

          <div class="article-body">
            <div class="prose">
              <ArticleVisual page={entry.id} />
              <Content />
            </div>

            <Quiz questions={data.quiz} />

            <SourceList sources={data.sources} />

            <RelatedTerms slugs={data.glossary} />

            <div data-course-navigation><PageNav prev={prev} next={next} /></div>
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
