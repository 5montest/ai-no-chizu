---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import zukanJson from '../../../data/zukan.json';
import pricingJson from '../../../data/zukan-pricing.json';
import modelComparisonJson from '../../../data/model-comparison.json';
import {
  AVAILABILITY_LABELS,
  VERIFICATION_LABELS,
  buildPriceIndex,
  compareEntities,
  formatUsd,
  groupByKind,
  entitySearchText,
  planSnapshotsFor,
  priceEntriesFor,
} from '../../lib/zukan.mjs';
import { withBase } from '../../lib/site.mjs';
import type { ModelComparison, Zukan, ZukanEntity, ZukanPricing, ZukanTerm } from '../../lib/zukan-types';

const zukan = zukanJson as unknown as Zukan;
const pricing = pricingJson as unknown as ZukanPricing;
const modelComparison = modelComparisonJson as unknown as ModelComparison;
const groups = groupByKind(zukan.entities, zukan.kinds);

const COST_MODEL_LABELS: Record<string, string> = {
  free: '無料',
  paid: '有料（月額・席単位など）',
  'usage-based': '従量課金',
  mixed: '無料枠と従量課金の併用',
  unknown: '料金体系 未確認',
};
const MODALITY_LABELS: Record<string, string> = {
  text: 'テキスト',
  image: '画像',
  audio: '音声',
  video: '動画',
  file: 'ファイル',
  vector: '数値ベクトル',
  classification: '分類結果・スコア',
};
const CONTEXT_BASIS_LABELS: Record<string, string> = {
  official: '提供元の公式情報',
  reseller: '再販事業者の掲載',
  unverified: '出所 未確認',
};
const ENVIRONMENT_LABELS: Record<string, string> = {
  'api-official': '提供元の公式API',
  'api-reseller': '再販事業者のAPI',
};
const TAX_LABELS: Record<string, string> = {
  excluded: '税別',
  included: '税込',
  unknown: '税の扱い未確認',
};
const UNIT_LABELS: Record<string, string> = {
  per_month: '月額',
  per_1m_tokens: '100万トークンあたり',
  per_request: '1リクエストあたり',
};
const SOURCE_KIND_LABELS: Record<string, string> = {
  official: '公式',
  reseller: '再販',
};

// 「よく比べる組み合わせ」。空の比較画面で、何を比べればよいかの手掛かりにする。
// id は必ず zukan.json に存在するものだけを書く（存在しない id は JS 側で捨てられる）。
const PRESETS: Array<{ label: string; ids: string[] }> = [
  { label: 'OpenAIの基盤モデル4件', ids: ['gpt-6-astra', 'gpt-6-1-sol', 'gpt-6-1-terra', 'gpt-6-luna'] },
  { label: 'Claudeの個人プラン3件', ids: ['claude-free', 'claude-pro', 'claude-max'] },
  { label: 'CLIハーネス4件', ids: ['claude-code', 'codex-cli', 'opencode', 'gemini-cli'] },
  { label: 'ChatGPTの料金プラン3件', ids: ['chatgpt-free', 'chatgpt-plus', 'chatgpt-pro-200'] },
  { label: '音声・文字起こし3件', ids: ['gpt-transcribe', 'gpt-4o-mini-tts', 'whisper-local'] },
  { label: '画像・OCR・埋め込み3件', ids: ['gpt-image-2', 'mistral-ocr-4-1', 'text-embedding-3-small'] },
];
const presetHref = (ids: string[]): string =>
  `${withBase('/zukan/compare/')}?${ids.map((id) => `ids=${encodeURIComponent(id)}`).join('&')}`;

const priceIndex = buildPriceIndex({ pricing, modelComparison });

/**
 * 比較表の金額セル。
 *
 * 1つのセルに1つの単位だけを置く。月額・トークン単価・用途ごとの従量単価は行を分け、
 * 単位・税の扱い・取得日・公式/再販の区分をセルの中（meta）に添える。
 * 金額が記録されていない場合は null を返し、呼び出し側が「未記録」か「対象外」を決める。
 */
type PriceCell = { text: string; meta: string };

const NOT_APPLICABLE = '—（対象外）';

const isNumber = (value: unknown): value is number =>
  typeof value === 'number' && Number.isFinite(value);

/** 条件の長い文字列はセル幅を壊すので、最初の区切りまでを短く出す。 */
const shortCondition = (condition: unknown): string => {
  const head = String(condition ?? '')
    .split('。')[0]
    .split('、')[0]
    .trim();
  return head.length > 20 ? `${head.slice(0, 20)}…` : head;
};

/** 料金スナップショットの出所・取得日・税。金額と同じセルに添える共通の接尾辞。 */
const priceMeta = (snapshot: { tax?: string; fetched_at?: string; source_kind?: string }): string =>
  `${TAX_LABELS[snapshot.tax ?? 'unknown'] ?? '税の扱い未確認'}・取得 ${snapshot.fetched_at ?? '未記録'}・${
    SOURCE_KIND_LABELS[snapshot.source_kind ?? ''] ?? '出所未確認'
  }`;

/** プランの月額。金額が無いときも、見積もり・地域別などの条件を書いて「0円」と読ませない。 */
const planMonthlyCell = (entityId: string): PriceCell | null => {
  const snapshots = planSnapshotsFor(pricing, entityId);
  const snapshot = snapshots[0];
  const plan = snapshot?.plans?.[0];
  if (!snapshot || !plan) return null;

  // プラン表は billing の下に月額・席条件を持つ形と、プラン直下に月額を持つ形がある。
  // 表示に使う欄だけをローカルに型付けし、記録に無い欄は null のまま扱う。
  type PlanView = {
    monthly_usd?: number | null;
    billing?: Record<string, unknown>;
    seats?: Array<{
      label: string;
      monthly_usd?: number | null;
      annual_monthly_usd?: number | null;
    }>;
    selection?: Array<{ label?: string }>;
    limits?: Record<string, unknown>;
  };
  const view = plan as unknown as PlanView;
  const billing = view.billing ?? {};
  const seats = view.seats ?? [];
  const limits = view.limits ?? {};
  const monthly = isNumber(billing.monthly_usd)
    ? formatUsd(billing.monthly_usd)
    : isNumber(view.monthly_usd)
      ? formatUsd(view.monthly_usd)
      : null;
  const monthlyFrom = isNumber(billing.monthly_usd_from) ? formatUsd(billing.monthly_usd_from) : null;
  const annualMonthly = isNumber(billing.annual_monthly_usd) ? formatUsd(billing.annual_monthly_usd) : null;
  const annualUpfront = isNumber(billing.annual_upfront_usd) ? formatUsd(billing.annual_upfront_usd) : null;
  const minSeats = isNumber(billing.minimum_seats) ? billing.minimum_seats : null;
  const maxSeats = isNumber(billing.maximum_seats) ? billing.maximum_seats : null;
  const firstSeat = seats[0];
  const firstSeatMonthly = isNumber(firstSeat?.monthly_usd) ? formatUsd(firstSeat.monthly_usd) : null;

  let text: string;
  if (monthly) text = `${monthly}／月`;
  else if (monthlyFrom) text = `${monthlyFrom}〜／月（下限のみ確認）`;
  else if (annualMonthly && billing.billing_period === 'year' && billing.seat_based) {
    text = `年払い ${annualMonthly}／月（1席あたり）`;
  } else if (firstSeat && firstSeatMonthly) text = `${firstSeat.label}席 ${firstSeatMonthly}／月`;
  else if (billing.billing_period === 'quote') text = '個別見積もり（営業窓口）';
  else if (billing.billing_period === 'regional') text = '地域別（申込画面で確認）';
  else if (billing.billing_period === 'route') text = '契約先・認証方法で確認';
  else text = '未確認（詳細ページに条件）';

  const meta: string[] = [];
  if (monthly && annualMonthly) {
    meta.push(annualUpfront ? `年払い ${annualMonthly}／月（${annualUpfront} を一括）` : `年払い ${annualMonthly}／月`);
  } else if (annualUpfront) {
    meta.push(`${annualUpfront} を一括`);
  }
  if (firstSeat && !monthly && isNumber(firstSeat.annual_monthly_usd)) {
    meta.push(`年払い ${formatUsd(firstSeat.annual_monthly_usd)}／月`);
  }
  const otherSeats = seats.slice(1).filter((seat) => isNumber(seat.monthly_usd));
  if (otherSeats.length > 0) {
    meta.push(
      otherSeats
        .map((seat) => `${seat.label}席 ${formatUsd(seat.monthly_usd as number)}／月`)
        .join('、'),
    );
  }
  if (minSeats !== null && maxSeats !== null) meta.push(`${minSeats}〜${maxSeats}席`);
  else if (minSeats !== null) meta.push(`${minSeats}席以上`);
  if (Array.isArray(view.selection) && view.selection.length > 0) {
    meta.push(
      `${view.selection.map((item) => item.label ?? '選択肢').join('・')}の実額は未確認`,
    );
  }
  if (limits.usage_billed_at === 'API rates') meta.push('利用量はAPI単価で別に課金');
  meta.push(priceMeta({ tax: snapshot.tax, fetched_at: snapshot.fetched_at, source_kind: snapshot.source_kind }));

  return { text, meta: meta.join('・') };
};

/** 従量のトークン単価。公式を先に読み、条件（standard など）も同じセルに添える。 */
const tokenRateCell = (entityId: string, side: 'input' | 'output'): PriceCell | null => {
  const entries = priceEntriesFor(priceIndex, entityId);
  const entry = entries[0];
  if (!entry || entry.tiers.length === 0) return null;
  const tier = entry.tiers.find((item) => item.condition === 'standard') ?? entry.tiers[0];
  const value = side === 'input' ? tier.input : tier.output;
  const meta: string[] = [shortCondition(tier.condition)];
  if (entry.tiers.length > 1) meta.push(`ほか${entry.tiers.length - 1}区分`);
  meta.push(UNIT_LABELS[entry.unit] ?? entry.unit);
  meta.push(priceMeta({ tax: entry.tax, fetched_at: entry.fetched_at, source_kind: entry.source_kind }));
  return { text: isNumber(value) ? formatUsd(value) : '未確認', meta: meta.join('・') };
};

/** 音声の分・画像の枚数など、用途ごとの従量単価。単位はセルの中に書く。 */
const usageChargeCell = (entity: ZukanEntity): PriceCell | null => {
  const snapshot = pricing.snapshots.find(
    (item) => entity.pricing_snapshot_ids.includes(item.id) && (item.charges ?? []).some((charge) => charge.entity_id === entity.id),
  );
  if (!snapshot) return null;
  const charges = (snapshot.charges ?? []).filter((charge) => charge.entity_id === entity.id);
  if (charges.length === 0) return null;
  const listed = charges
    .slice(0, 2)
    .map((charge) => `${charge.label} ${formatUsd(charge.price)}／${charge.unit}`);
  const rest = charges.length - listed.length;
  return {
    text: `${listed.join('、')}${rest > 0 ? ` ほか${rest}項目` : ''}`,
    meta: priceMeta({ tax: snapshot.tax, fetched_at: snapshot.fetched_at, source_kind: snapshot.source?.kind }),
  };
};

const labelMap = (items: ZukanTerm[]): Map<string, string> =>
  new Map(items.map((item): [string, string] => [item.id, item.label]));
const useCaseLabels = labelMap(zukan.use_cases);
const interfaceLabels = labelMap(zukan.interfaces);
const platformLabels = labelMap(zukan.platforms);
const accessRouteLabels = labelMap(zukan.access_routes);

/** 配列が空のときは「未確認」と書かない。試した結果なのか、そもそも記録が無いのかを分ける。 */
const joinOrNone = (values: readonly string[] | null | undefined): string => {
  const items = (values ?? []).filter(Boolean);
  return items.length > 0 ? items.join('、') : '未記録';
};

const contextText = (entity: ZukanEntity): string => {
  const window = entity.context_window;
  if (!window || typeof window.tokens !== 'number') return entity.context_label ?? (entity.kind === 'model' ? '未確認' : '製品・設定による');
  return `${window.tokens.toLocaleString('ja-JP')} トークン（${CONTEXT_BASIS_LABELS[window.basis] ?? window.basis}）`;
};

const modelIdText = (entity: ZukanEntity): string => {
  const ids = entity.model_ids ?? [];
  if (ids.length === 0) return '未記録';
  return ids
    .map((modelId) => `${modelId.id}（${modelId.provider}／${ENVIRONMENT_LABELS[modelId.environment] ?? modelId.environment}）`)
    .join('、');
};

const cautionText = (entity: ZukanEntity): string => {
  const items = [...(entity.not_suitable_for ?? []), ...(entity.limitations ?? [])].filter(Boolean);
  return items.length > 0 ? items.join('、') : '未記録';
};

const strengthText = (entity: ZukanEntity): string => {
  const items = (entity.strengths ?? []).filter(Boolean);
  return items.length > 0 ? items.slice(0, 3).join('、') : '未記録';
};

// 行は「どの分類にも共通して聞けること」だけにする。
// 片方の分類にしか無い項目を並べると、空欄が「できない」と読めてしまう。
// 金額は単位が違うため、月額・トークン単価（入力/出力）・用途別の従量単価で行を分ける。
// 分類上その行を持たない項目は「未記録」ではなく「—（対象外）」と書き、行自体は
// 選択した項目のどれか1つでも値を持つときだけ表示する（JS側で判定）。
const ROWS = [
  { key: 'kindLabel', label: '分類' },
  { key: 'vendor', label: '提供元' },
  { key: 'availability', label: '提供状況' },
  { key: 'verification', label: '情報の状態' },
  { key: 'useCases', label: '主な用途' },
  { key: 'interfaces', label: '使う場所' },
  { key: 'platforms', label: '対応OS・環境' },
  { key: 'access', label: '利用できる経路' },
  { key: 'modalities', label: '入出力' },
  { key: 'cost', label: '料金体系' },
  { key: 'planMonthly', label: '月額（プラン）' },
  { key: 'inputRate', label: '従量 入力単価' },
  { key: 'outputRate', label: '従量 出力単価' },
  { key: 'usageCharges', label: '従量単価（用途別）' },
  { key: 'requires', label: '必要なもの' },
  { key: 'strengths', label: '得意なこと' },
  { key: 'cautions', label: '向かないこと・注意' },
  { key: 'modelIds', label: 'モデルID' },
  { key: 'context', label: '文脈長' },
  { key: 'checked', label: '最終確認日' },
];

const kindOf = (entity: ZukanEntity): ZukanTerm | undefined =>
  zukan.kinds.find((item) => item.id === entity.kind);

const recordOf = (entity: ZukanEntity) => {
  const kind = kindOf(entity);
  const planMonthly = planMonthlyCell(entity.id);
  const inputRate = tokenRateCell(entity.id, 'input');
  const outputRate = tokenRateCell(entity.id, 'output');
  const usageCharges = usageChargeCell(entity);
  // 対象外の行を「未記録」と書くと、記録漏れと区別できない。分類上の持ち物が違うだけなので分ける。
  const planMonthlyText = planMonthly?.text ?? (entity.kind === 'plan' ? '未記録' : NOT_APPLICABLE);
  const inputRateText = inputRate?.text ?? (entity.kind === 'model' ? '未記録' : NOT_APPLICABLE);
  const outputRateText = outputRate?.text ?? (entity.kind === 'model' ? '未記録' : NOT_APPLICABLE);
  const usageChargesText =
    usageCharges?.text ?? (entity.kind === 'specialized-model' ? '未記録' : NOT_APPLICABLE);
  return {
    display_name: entity.display_name,
    kind: entity.kind,
    kindLabel: kind?.label ?? entity.kind,
    href: withBase(`/zukan/${entity.slug}/`),
    vendor: entity.vendor,
    checked: entity.last_checked_at,
    values: {
      kindLabel: kind?.label ?? entity.kind,
      vendor: entity.vendor,
      availability: AVAILABILITY_LABELS[entity.availability_status] ?? '提供中',
      verification: VERIFICATION_LABELS[entity.verification_status] ?? '提供元の公式情報で確認',
      useCases: joinOrNone(
        (entity.primary_use_cases ?? []).map((id) => useCaseLabels.get(id) ?? id),
      ),
      interfaces: joinOrNone(
        (entity.interfaces ?? []).map((id) => interfaceLabels.get(id) ?? id),
      ),
      platforms: joinOrNone(
        (entity.platforms ?? []).map((id) => platformLabels.get(id) ?? id),
      ),
      access: joinOrNone(
        (entity.available_via ?? []).map((id) => accessRouteLabels.get(id) ?? id),
      ),
      modalities: joinOrNone([
        ...(entity.input_modalities ?? []).map((id) => `入力 ${MODALITY_LABELS[id] ?? id}`),
        ...(entity.output_modalities ?? []).map((id) => `出力 ${MODALITY_LABELS[id] ?? id}`),
      ]),
      cost: COST_MODEL_LABELS[entity.cost_model] ?? '料金体系 未確認',
      planMonthly: planMonthlyText,
      inputRate: inputRateText,
      outputRate: outputRateText,
      usageCharges: usageChargesText,
      requires: joinOrNone(entity.requires),
      strengths: strengthText(entity),
      cautions: cautionText(entity),
      modelIds: modelIdText(entity),
      context: contextText(entity),
      checked: entity.last_checked_at,
    },
    // 金額セルの下に小さく添える行。単位・税・取得日・公式/再販の区分。
    notes: {
      planMonthly: planMonthly?.meta ?? '',
      inputRate: inputRate?.meta ?? '',
      outputRate: outputRate?.meta ?? '',
      usageCharges: usageCharges?.meta ?? '',
    },
  };
};

// 分類の組み合わせごとの注記は、一覧・詳細と同じ compareEntities の規則から作る。
// 文面を別に書くと、同じ状況でページごとに言うことが変わる。
const presentKinds = zukan.kinds.map((kind) => kind.id).filter((id) => zukan.entities.some((entity) => entity.kind === id));
const combinations = (items: string[], size: number): string[][] => {
  if (size === 0) return [[]];
  if (items.length < size) return [];
  const [head, ...rest] = items;
  return [...combinations(rest, size - 1).map((combo) => [head, ...combo]), ...combinations(rest, size)];
};
const layerNotes: Record<string, string> = {};
for (let size = 2; size <= presentKinds.length; size += 1) {
  for (const combo of combinations(presentKinds, size)) {
    const synthetic = combo.map((id) => ({ id: `kind-${id}`, kind: id }));
    const note = compareEntities(synthetic, synthetic.map((item) => item.id), zukan.kinds)
      .layerNote;
    if (note) layerNotes[[...combo].sort().join('|')] = note;
  }
}

const payload = {
  rows: ROWS,
  entities: Object.fromEntries(zukan.entities.map((entity) => [entity.id, recordOf(entity)])),
  layerNotes,
  kindLabels: Object.fromEntries(zukan.kinds.map((kind) => [kind.id, kind.label])),
  max: 6,
  notApplicable: NOT_APPLICABLE,
};
---

<BaseLayout
  title="AI図鑑の比較"
  description="AI図鑑に登録した製品を2件以上選び、分類・用途・月額や従量単価・確認日を横に並べて見くらべるページです。"
>
  <div class="page">
    <div class="shell">
      <div class="zukan-page zukan-page--wide">
        <Breadcrumb
          items={[{ label: 'AI図鑑', href: withBase('/zukan/') }, { label: '比較' }]}
        />

        <div class="section-head section-head--left page-head">
          <h1>AI図鑑の比較</h1>
          <p>
            2件以上を選ぶと、共通する項目だけを横に並べます。モデルとハーネスのように層が違うものを選んだ場合は、
            優劣ではなく役割の違いとして並べ、その旨を表の上に書きます。
          </p>
        </div>

        <form class="compare-form" data-compare-form action={withBase('/zukan/compare/')} method="get">
          <div class="compare-filters">
            <label>名前・提供元で探す<input type="search" data-compare-search placeholder="例：GPT、Claude、DeepSeek" autocomplete="off" /></label>
            <label>分類<select data-compare-kind><option value="all">すべて</option>{zukan.kinds.map(kind => <option value={kind.id}>{kind.label}</option>)}</select></label>
          </div>
          <div class="compare-empty" data-compare-empty>
            <p class="compare-empty__lead">
              2件以上を選ぶと、ここに比較表が出ます。まずは次の組み合わせから試せます。
            </p>
            <div class="compare-empty__presets" role="group" aria-label="よく比べる組み合わせ">
              {PRESETS.map((preset) => (
                <a class="chip" href={presetHref(preset.ids)}>{preset.label}</a>
              ))}
            </div>
          </div>
          <p data-compare-visible class="compare-count" aria-live="polite"></p>
          <p class="compare-hidden-note" data-compare-hidden hidden></p>
          {groups.map((group) => (
            <fieldset class="compare-fieldset" data-compare-group data-kind={group.kind.id}>
              <legend>
                {group.kind.label}
                <span class="zukan-group__count">{group.entities.length}件</span>
              </legend>
              <div class="compare-choices">
                {group.entities.map((entity) => (
                  <label class="compare-choice" data-compare-choice data-search={entitySearchText(entity)}>
                    <input type="checkbox" name="ids" value={entity.id} />
                    <span>
                      <span class="compare-choice__name">{entity.display_name}</span>
                      <span class="compare-choice__meta">
                        {entity.vendor}／確認 {entity.last_checked_at}
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="compare-actions">
            <button class="btn" type="submit" data-compare-submit disabled>比較表を見る</button>
            <button class="btn btn--ghost" type="button" data-compare-reset>選択を解除する</button>
            <span class="compare-count" data-compare-status aria-live="polite">選択中 0/6件</span>
            <span class="compare-limit">最大6件まで選べます。7件目以降は選べません。すでに選んだ6件はそのまま残ります。</span>
          </div>
        </form>

        <p class="compare-message" data-compare-message aria-live="polite"></p>

        <div class="compare-result" data-compare-root tabindex="-1" role="region" aria-label="比較結果"></div>

        <noscript>
          <p class="zukan-note">
            比較表はブラウザ上で組み立てるため、JavaScript を有効にすると表示されます。
            各項目の内容は<a href={withBase('/zukan/')}>AI図鑑の一覧</a>から個別のページで読めます。
          </p>
        </noscript>

        <section class="zukan-footnote">
          <h2>比較表の読み方</h2>
          <p>
            「未記録」は、その項目の記載がまだ無いことを表します。「未確認」は、確認を試みたものの公式の記載が
            見つからなかったことを表します。「—（対象外）」は、その分類では記録しない項目です。
            どれも「使えない」「0円」という意味ではありません。
          </p>
          <p>
            金額は「月額（プラン）」「従量 入力単価」「従量 出力単価」「従量単価（用途別）」に行を分けて表示します。
            同じ行に単位の違う金額は混ぜず、各セルに単位・税の扱い・取得日・公式か再販かを添えています。
            月額はプランの契約金額、従量単価はAPI利用時の100万トークンあたりなどの単価で、両者を足した総額は表示していません。
            金額の記録が無いセルは「未記録」です。詳しい条件は<a href={withBase('/zukan/')}>一覧</a>から個別のページで確認してください。
          </p>
        </section>
      </div>
    </div>
  </div>

  <script define:vars={{ payload }}>
    const form = document.querySelector('[data-compare-form]');
    const checkboxes = [...document.querySelectorAll('input[name="ids"]')];
    const statusEl = document.querySelector('[data-compare-status]');
    const messageEl = document.querySelector('[data-compare-message]');
    const root = document.querySelector('[data-compare-root]');
    const resetButton = document.querySelector('[data-compare-reset]');
    const emptyEl = document.querySelector('[data-compare-empty]');
    const hiddenNoteEl = document.querySelector('[data-compare-hidden]');

    const known = new Set(Object.keys(payload.entities));

    // 正しい形式は ?ids=a&ids=b。古いカンマ連結のリンク（?ids=a,b）も開けるよう分割して読む。
    const readIds = () => {
      const seen = [];
      for (const raw of new URLSearchParams(location.search).getAll('ids')) {
        for (const id of raw.split(',')) {
          const value = id.trim();
          if (known.has(value) && !seen.includes(value)) seen.push(value);
        }
      }
      return seen.slice(0, payload.max);
    };

    // 金額セルは、金額（text）と、単位・税・取得日・公式/再販（meta）を分けて出す。
    // 1つのセルに詰め込むと読めなくなるため、meta は小さく下に置く。
    const cell = (text, meta) => {
      const td = document.createElement('td');
      const main = document.createElement('span');
      main.textContent = text;
      td.append(main);
      if (meta) {
        const note = document.createElement('span');
        note.className = 'compare-cell__meta';
        note.textContent = meta;
        td.append(note);
      }
      return td;
    };

    /** 選択件数と上限の表示は1か所にまとめる。候補数とは別の行に書く。 */
    const selectionText = (count) => {
      if (count >= payload.max) return `選択中 ${count}/${payload.max}件（上限）`;
      return `選択中 ${count}/${payload.max}件（あと${payload.max - count}件）`;
    };

    /** 絞り込みで隠れている選択済み項目の件数を、操作位置の近くに出す。 */
    const updateHiddenNote = () => {
      if (!hiddenNoteEl) return;
      const hiddenSelected = checkboxes.filter(
        (box) => box.checked && box.closest('[data-compare-choice]')?.hidden,
      ).length;
      hiddenNoteEl.hidden = hiddenSelected === 0;
      hiddenNoteEl.textContent =
        hiddenSelected > 0
          ? `絞り込みで隠れている選択済みの項目が${hiddenSelected}件あります。比較表には含まれます。`
          : '';
    };

    function render(ids) {
      root.replaceChildren();
      const selected = ids.length > 0;
      document.querySelector('.compare-actions')?.classList.toggle('is-floating', selected);
      document.body.classList.toggle('has-compare-tray', selected);
      document.querySelector('[data-compare-submit]').disabled = ids.length < 2;
      try { sessionStorage.setItem('ai-map-compare', JSON.stringify(ids)); } catch { /* 保存は任意 */ }
      if (statusEl) statusEl.textContent = selectionText(ids.length);
      if (emptyEl) emptyEl.hidden = ids.length >= 2;
      updateHiddenNote();

      if (ids.length < 2) {
        if (messageEl) {
          // 未選択のときは上の空状態パネルが説明するので、ここでは繰り返さない。
          messageEl.textContent =
            ids.length === 0
              ? ''
              : 'あと1つ選ぶと比較できます。同じ分類の中から選ぶと、役割が近いもの同士で比べられます。';
        }
        return;
      }

      const kinds = [...new Set(ids.map((id) => payload.entities[id].kind))];
      const note =
        kinds.length === 1
          ? `同じ${payload.kindLabels[kinds[0]] ?? kinds[0]}の項目同士なので、役割が近く、並べて比べられます。`
          : payload.layerNotes[[...kinds].sort().join('|')] ?? null;

      if (messageEl) messageEl.textContent = note ?? '';

      // 選択した項目のどれか1つでも値を持つ行だけを出す。分類上持たない行（例：モデルだけを
      // 選んだときの「月額（プラン）」）は、丸ごと省いて表を短くする。
      const rows = payload.rows.filter((row) =>
        ids.some((id) => (payload.entities[id].values[row.key] ?? '') !== payload.notApplicable),
      );

      const heading = document.createElement('h2');heading.className = 'compare-result__title';heading.textContent = `比較結果 · ${ids.length}件`;root.append(heading);

      const hint = document.createElement('p');
      hint.className = 'compare-scroll-hint';
      hint.textContent = '横にスクロールできます。金額の行は、単位・税・取得日・公式/再販を各セルの下に添えています。';
      root.append(hint);

      const wrap = document.createElement('div');
      wrap.className = 'model-table-wrap';
      const table = document.createElement('table');
      table.className = 'model-table compare-table';

      const caption = document.createElement('caption');
      caption.className = 'compare-caption';
      caption.textContent = `${ids.length}件を並べています。空欄は作らず、記録が無い項目は「未記録」、分類上持たない項目は「—（対象外）」と書いています。横にスクロールできます。`;
      table.append(caption);

      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      const corner = document.createElement('th');
      corner.scope = 'col';
      corner.textContent = '項目';
      headRow.append(corner);
      for (const id of ids) {
        const entity = payload.entities[id];
        const th = document.createElement('th');
        th.scope = 'col';
        const link = document.createElement('a');
        link.href = entity.href;
        link.textContent = entity.display_name;
        th.append(link);
        const meta = document.createElement('span');
        meta.className = 'compare-col-meta';
        meta.textContent = entity.vendor;
        th.append(meta);
        headRow.append(th);
      }
      thead.append(headRow);
      table.append(thead);

      const tbody = document.createElement('tbody');
      for (const row of rows) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = row.label;
        tr.append(th);
        for (const id of ids) {
          const entity = payload.entities[id];
          tr.append(cell(entity.values[row.key] ?? '未記録', entity.notes?.[row.key]));
        }
        tbody.append(tr);
      }
      table.append(tbody);
      wrap.append(table);
      root.append(wrap);
      // スマホでは項目ごとに製品を並べ、横に往復しなくても読めるようにする。
      const cards = document.createElement('div');cards.className = 'compare-mobile';
      for (const row of rows) {
        const section = document.createElement('section');
        const heading = document.createElement('h3');heading.textContent = row.label;
        const values = document.createElement('dl');
        for (const id of ids) {
          const entity = payload.entities[id];
          const pair = document.createElement('div');
          const name = document.createElement('dt');
          const link = document.createElement('a');link.href = entity.href;link.textContent = entity.display_name;name.append(link);
          const value = document.createElement('dd');
          const main = document.createElement('span');
          main.textContent = entity.values[row.key] ?? '未記録';
          value.append(main);
          const metaText = entity.notes?.[row.key];
          if (metaText) {
            const note = document.createElement('span');
            note.className = 'compare-cell__meta';
            note.textContent = metaText;
            value.append(note);
          }
          pair.append(name, value);values.append(pair);
        }
        section.append(heading, values);cards.append(section);
      }
      root.append(cards);
    }

    function syncCheckboxes(ids) {
      for (const box of checkboxes) box.checked = ids.includes(box.value);
    }

    function currentIds() {
      return checkboxes.filter((box) => box.checked).map((box) => box.value);
    }

    function updateUrl(ids) {
      const params = new URLSearchParams();
      for (const id of ids) params.append('ids', id);
      const query = params.toString();
      const url = `${location.pathname}${query ? `?${query}` : ''}`;
      history.replaceState(null, '', url);
    }

    const search = document.querySelector('[data-compare-search]');
    const kindFilter = document.querySelector('[data-compare-kind]');
    const normalize = text => text.normalize('NFKC').toLowerCase().trim();
    const filter = () => {
      const tokens = normalize(search.value).split(/\s+/).filter(Boolean);
      let count = 0;
      for (const group of document.querySelectorAll('[data-compare-group]')) {
        let shown = 0;
        for (const choice of group.querySelectorAll('[data-compare-choice]')) {
          const visible = (kindFilter.value === 'all' || group.dataset.kind === kindFilter.value) && tokens.every(token => normalize(choice.dataset.search).includes(token));
          choice.hidden = !visible;if (visible) shown++;
        }
        group.hidden = shown === 0;count += shown;
      }
      document.querySelector('[data-compare-visible]').textContent = count ? `候補 ${count}件` : '一致する候補がありません。検索語や分類を変えてください。';
      updateHiddenNote();
    };
    search.addEventListener('input', filter);kindFilter.addEventListener('change', filter);filter();
    const initial = readIds();
    syncCheckboxes(initial);
    render(initial);
    if (initial.length >= 2) requestAnimationFrame(() => root.scrollIntoView({ behavior: 'instant', block: 'start' }));
    window.addEventListener('popstate', () => { const ids = readIds();syncCheckboxes(ids);render(ids); });

    form?.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLInputElement) || event.target.name !== 'ids') return;
      if (currentIds().length > payload.max) {
        event.target.checked = false;
        render(currentIds());
        if (statusEl) statusEl.textContent = `選択中 ${payload.max}/${payload.max}件（上限）。${payload.max}件を超えては選べません。`;
        return;
      }
      const selected = currentIds();
      updateUrl(selected);render(selected);
    });

    form?.addEventListener('submit', (event) => {
      // 静的サイトなので送信しても表は変わらない。選択の反映はその場で行う。
      event.preventDefault();
      const ids = currentIds();render(ids);
      if (ids.length >= 2) { root.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });root.focus({ preventScroll: true }); }
    });

    resetButton?.addEventListener('click', () => {
      syncCheckboxes([]);
      updateUrl([]);
      render([]);
      filter();
    });
  </script>

  <style>
    /* JS が組み立てる表のセルにも効くよう、テンプレート内の .compare-result から :global で指す。 */
    .compare-result :global(.compare-cell__meta) {
      display: block;
      margin-top: 0.25rem;
      color: var(--ink-mute);
      font-size: 0.7rem;
      font-weight: 400;
      line-height: 1.55;
    }

    /* 横スクロールの手掛かり。スマホはカード表示なので案内を出さない。 */
    .compare-result :global(.compare-scroll-hint) {
      margin: 0 0 0.4rem;
      color: var(--ink-mute);
      font-size: 0.75rem;
      line-height: 1.7;
    }

    @media (max-width: 640px) {
      .compare-result :global(.compare-scroll-hint) {
        display: none;
      }
    }

    /* 行見出しと見出し行の先頭セルを左端に固定し、横スクロール中も「いま何の行か」を残す。 */
    .compare-result :global(.compare-table thead th:first-child),
    .compare-result :global(.compare-table tbody th) {
      position: sticky;
      left: 0;
      background: var(--plate);
    }

    .compare-result :global(.compare-table tbody th) {
      z-index: 1;
      box-shadow: 1px 0 0 var(--line);
    }

    .compare-result :global(.compare-table thead th:first-child) {
      top: 0;
      z-index: 3;
      background: var(--paper-2);
      box-shadow: 1px 0 0 var(--line);
    }

    /* 空状態と、よく比べる組み合わせのチップ。候補一覧の上で、何を比べるかの手掛かりを出す。 */
    .compare-empty {
      margin: 0 0 1rem;
      padding: 0.9rem 1rem;
      border: 1px dashed var(--line-strong);
      border-radius: var(--radius);
      background: var(--paper-2);
    }

    .compare-empty__lead {
      margin: 0 0 0.6rem;
      color: var(--ink-soft);
      font-size: 0.875rem;
      line-height: 1.8;
    }

    .compare-empty__presets {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .compare-hidden-note {
      margin: 0.25rem 0 0.6rem;
      color: var(--warn);
      font-size: 0.8125rem;
      line-height: 1.7;
    }

    .compare-limit {
      color: var(--ink-mute);
      font-size: 0.75rem;
      line-height: 1.6;
    }

    /* 画面下に固定されるときは、長い上限説明を隠して1〜2行に収める。
       上限の説明は上の操作ボタン付近に出ているので、情報は失われない。 */
    :global(.compare-actions.is-floating) .compare-limit {
      display: none;
    }
  </style>
</BaseLayout>
