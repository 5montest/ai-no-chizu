---
import GuideIcon from '../../components/GuideIcon.astro';
import GuideImage from '../../components/GuideImage.astro';
import ProviderMark from '../../components/ProviderMark.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import zukanJson from '../../../data/zukan.json';
import { entityBadges, entitySearchText, groupByKind, priceBucket } from '../../lib/zukan.mjs';
import { withBase } from '../../lib/site.mjs';
import type { Zukan, ZukanEntity } from '../../lib/zukan-types';

const zukan = zukanJson as unknown as Zukan;
const entities = zukan.entities;
const kindIcons: Record<string,string> = {model:'chip', 'specialized-model':'sound', harness:'tools', app:'document', plan:'coins'};
const groups = groupByKind(entities, zukan.kinds);
const useCases = zukan.use_cases;
const interfaces = zukan.interfaces;

// 種類だけで束ねると、基盤モデル18件と契約19件が1枚の格子に並び、どこから読めばよいか分からない。
// そこで種類の下に副分類を置く。副分類は優劣の判断ではなく、記録済みの値だけで機械的に決める。
const SPECIALIZED_FAMILIES = [
  { id: 'speech', label: '音声の認識・合成', uses: ['speech-to-text', 'text-to-speech'] },
  { id: 'image', label: '画像の生成・編集', uses: ['image-generation'] },
  { id: 'embedding', label: '埋め込み・検索', uses: ['embeddings'] },
  { id: 'document', label: '文書からの抽出', uses: ['ocr'] },
  { id: 'moderation', label: '有害性の判定', uses: ['moderation'] },
];

const familyOf = (entity: ZukanEntity) =>
  SPECIALIZED_FAMILIES.find((family) =>
    (entity.primary_use_cases ?? []).some((use) => family.uses.includes(use)),
  );

type Subgroup = { key: string; label: string | null; entities: ZukanEntity[] };

// 基盤モデルと契約は提供元、専用モデルは用途、ハーネスとアプリは件数が少ないので副分類を置かない。
function subgroupsFor(kindId: string, list: ZukanEntity[]): Subgroup[] {
  if (kindId === 'model' || kindId === 'plan') {
    const byVendor = new Map<string, ZukanEntity[]>();
    for (const entity of list) {
      const vendor = entity.vendor ?? '提供元不明';
      byVendor.set(vendor, [...(byVendor.get(vendor) ?? []), entity]);
    }
    return [...byVendor.entries()]
      .sort(([left], [right]) => (left < right ? -1 : left > right ? 1 : 0))
      .map(([vendor, items]) => ({ key: vendor, label: vendor, entities: items }));
  }
  if (kindId === 'specialized-model') {
    const buckets = SPECIALIZED_FAMILIES.map((family) => ({
      key: family.id,
      label: family.label as string | null,
      entities: list.filter((entity) => familyOf(entity)?.id === family.id),
    }));
    const rest = list.filter((entity) => !familyOf(entity));
    if (rest.length > 0) buckets.push({ key: 'other', label: 'その他', entities: rest });
    return buckets.filter((bucket) => bucket.entities.length > 0);
  }
  return [{ key: kindId, label: null, entities: list }];
}

const sections = groups.map((group) => ({
  ...group,
  subgroups: subgroupsFor(group.kind.id, group.entities),
}));

const PRICE_FILTERS = [
  { id: 'all', label: 'すべて' },
  { id: 'free', label: '無料' },
  { id: 'paid', label: '有料' },
  { id: 'unknown', label: '料金未確認' },
];

// 無料・有料の判定は cost_model だけを見る。価格が未確認のものを無料に寄せない。
// 状態バッジの文言と色分けは entityBadges() にあり、一覧・詳細・比較で共通。

// 概要が空の項目もある。空欄のカードを作らず、記録が無いことを書く。
const summaryOf = (entity: ZukanEntity) =>
  entity.strengths?.[0] ?? entity.notes ?? '概要はまだ記録していません。';

const modelCount = entities.reduce(
  (total: number, entity: ZukanEntity) => total + (entity.model_ids?.length ?? 0),
  0,
);
---

<BaseLayout
  title="AI図鑑"
  description={`${entities.length}件のモデル・ハーネス・アプリ・プランを、名前・用途・条件から探せる一覧です。確認日と出典を併記しています。`}
>
  <div class="page">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href={withBase('/')}>ホーム</a><span aria-hidden="true">/</span><span>AI図鑑</span>
      </nav>

      <div class="section-head section-head--left page-head">
        <h1>AI図鑑</h1>
        <p>
          いま使えるAIの製品を、名前・用途・条件から探せる一覧です。モデル、それを動かすハーネス、利用者が触るアプリ、
          契約するプランは別の層なので、分けて登録しています。各項目には確認日と出典を付け、確認できていない事項は
          「未確認」と書いています。
        </p>
      </div>

      <details class="zukan-overview-visual"><summary>モデル・アプリ・プランの違いを図で見る</summary><GuideImage name="model-app-provider" /></details>
      <p class="zukan-lede">
        いま {entities.length}件（モデルID {modelCount}件）を登録しています。2件以上を並べて見くらべるには
        <a href={withBase('/zukan/compare/')}>比較</a>を使います。
      </p>

      <div class="glossary-tools zukan-tools">
        <label class="search-field">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.2"></circle>
            <path d="m12.6 12.6 4 4"></path>
          </svg>
          <span class="sr-only">AI製品を検索</span>
          <input
            type="search"
            placeholder="名前・用途・提供元・モデルIDから検索"
            data-zukan-search
            autocomplete="off"
          />
        </label>

        <div class="filter-chips" role="group" aria-label="分類で絞り込む">
          <button class="filter-chip is-active" type="button" data-kind="all">すべて</button>
          {zukan.kinds.map((kind) => (
            <button class="filter-chip" type="button" data-kind={kind.id}>{kind.label}</button>
          ))}
        </div>

        <div class="filter-chips" role="group" aria-label="料金の区分で絞り込む">
          {PRICE_FILTERS.map((filter, index) => (
            <button
              class:list={['filter-chip', { 'is-active': index === 0 }]}
              type="button"
              data-price={filter.id}
            >
              {filter.label}
            </button>
          ))}
        </div>

        <div class="zukan-selects">
          <label>
            <span>用途</span>
            <select data-zukan-use>
              <option value="all">すべて</option>
              {useCases.map((useCase) => (
                <option value={useCase.id}>{useCase.label}</option>
              ))}
            </select>
          </label>
          <label>
            <span>使う場所</span>
            <select data-zukan-interface>
              <option value="all">すべて</option>
              {interfaces.map((item) => (
                <option value={item.id}>{item.label}</option>
              ))}
            </select>
          </label>
        </div>
      </div>

      <p class="zukan-group__note">提供元名の横に、公式サイトのアイコンを添えています。基盤モデルと契約は提供元、専用モデルは用途で小分けにしています。モデル・アプリ・プランの区分もあわせて確認してください。</p>
      <p class="glossary-count" data-zukan-count aria-live="polite">{entities.length}件を表示中</p>

      <div data-zukan-groups>
        {sections.map((section) => (
          <section class="zukan-group" data-zukan-group aria-labelledby={`kind-${section.kind.id}`}>
            <h2 id={`kind-${section.kind.id}`}>
              <GuideIcon name={kindIcons[section.kind.id] ?? 'book'} /> {section.kind.label}
              <span class="zukan-group__count" data-group-count>{section.entities.length}件</span>
            </h2>
            <p class="zukan-group__note">{section.kind.description}</p>
            {section.subgroups.map((subgroup) => (
              <div class="zukan-subgroup" data-zukan-subgroup>
                {subgroup.label && (
                  <h3 class="zukan-subgroup__head">
                    <span>{subgroup.label}</span>
                    <span class="zukan-group__count" data-subgroup-count>{subgroup.entities.length}件</span>
                  </h3>
                )}
                <div class="glossary-grid">
                  {subgroup.entities.map((entity) => (
                    <a
                      class="term-card zukan-card"
                      href={withBase(`/zukan/${entity.slug}/`)}
                      data-entity
                      data-kind={entity.kind}
                      data-price={priceBucket(entity)}
                      data-use={(entity.primary_use_cases ?? []).join(' ')}
                      data-iface={(entity.interfaces ?? []).join(' ')}
                      data-search={entitySearchText(entity)}
                    >
                      <span class="zukan-card__provider"><ProviderMark vendor={entity.vendor} compact={subgroup.label === entity.vendor} /></span>
                      <span class="term-card__cat">
                        {section.kind.label}
                        {entityBadges(entity).map((badge) => (
                          <span class:list={['badge', { 'badge--warn': badge.tone === 'warn' }]}>
                            {badge.text}
                          </span>
                        ))}
                      </span>
                      <span class="term-card__term">{entity.display_name}</span>
                      <p class="term-card__short">{summaryOf(entity)}</p>
                      <span class="zukan-card__meta">
                        確認 {entity.last_checked_at}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>

      <div class="empty-state" data-zukan-empty hidden>
        <p>条件に一致する項目がありません。検索語を短くするか、分類と用途の絞り込みを外してみてください。</p>
        <button class="btn" type="button" data-zukan-reset>絞り込みを解除する</button>
      </div>

      <section class="zukan-footnote">
        <h2>この一覧の読み方</h2>
        <p>
          種類の下の小分けは、基盤モデルと契約は提供元、専用モデルは用途で分けています。どちらも登録済みの値から
          機械的に決めており、性能や優劣の順位ではありません。同じ小分けの中でも、できることと条件は項目ごとに違います。
        </p>
        <p>
          料金の区分は、各項目の <code>cost_model</code> の記録だけを見ています。価格表が未確認のものは「無料」にも
          「有料」にも寄せず、「料金未確認」に分けています。金額そのものは各項目のページに、
          取得日・通貨・税の扱いとあわせて載せています。
        </p>
        <p>
          「未確認」は「使えない」という意味ではありません。公式に記載が見つからなかった、という意味です。
          確認できた範囲は項目ごとに違い、確認日も同じではありません。
        </p>
      </section>
    </div>
  </div>

  <script>
    // 絞り込みの規則は src/lib/zukan.mjs の normalizeQuery / filterEntities と揃える。
    // 検索語は NFKC → 小文字 → 空白の畳み込み。空白区切りの語はすべて含むときだけ一致。
    const normalize = (value: string) =>
      value.normalize('NFKC').toLowerCase().replace(/\s+/g, ' ').trim();

    const search = document.querySelector<HTMLInputElement>('[data-zukan-search]');
    // 製品カード（<a>）も data-kind / data-price を持つ。button に限定しないと、
    // カードに is-active を付けたり絞り込みの click を奪ったりしてしまう。
    const kindChips = [...document.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
    const priceChips = [...document.querySelectorAll<HTMLButtonElement>('button[data-price]')];
    const useSelect = document.querySelector<HTMLSelectElement>('[data-zukan-use]');
    const interfaceSelect = document.querySelector<HTMLSelectElement>('[data-zukan-interface]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-entity]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-zukan-group]')];
    const subgroups = [...document.querySelectorAll<HTMLElement>('[data-zukan-subgroup]')];
    const count = document.querySelector<HTMLElement>('[data-zukan-count]');
    const empty = document.querySelector<HTMLElement>('[data-zukan-empty]');
    const reset = document.querySelector<HTMLButtonElement>('[data-zukan-reset]');

    const state = { kind: 'all', price: 'all', use: 'all', iface: 'all' };

    const hasValue = (list: string, value: string) =>
      value === 'all' || ` ${list} `.includes(` ${value} `);

    function apply() {
      const tokens = normalize(search?.value ?? '').split(' ').filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? '';
        const show =
          (state.kind === 'all' || card.dataset.kind === state.kind) &&
          (state.price === 'all' || card.dataset.price === state.price) &&
          hasValue(card.dataset.use ?? '', state.use) &&
          hasValue(card.dataset.iface ?? '', state.iface) &&
          tokens.every((token) => text.includes(token));
        card.hidden = !show;
        if (show) visible += 1;
      }
      // 見出しの件数は、絞り込みで見えている枚数に合わせる。
      // 総数を残すと「5件」と書かれた見出しの下に1枚しか並ばず、数え間違いに見える。
      const shownIn = (root: HTMLElement) =>
        [...root.querySelectorAll<HTMLElement>('[data-entity]')].filter((card) => !card.hidden)
          .length;

      for (const subgroup of subgroups) {
        const visible = shownIn(subgroup);
        subgroup.hidden = visible === 0;
        const label = subgroup.querySelector<HTMLElement>('[data-subgroup-count]');
        if (label) label.textContent = `${visible}件`;
      }
      for (const group of groups) {
        const visible = shownIn(group);
        group.hidden = visible === 0;
        const label = group.querySelector<HTMLElement>('[data-group-count]');
        if (label) label.textContent = `${visible}件`;
      }
      if (count) count.textContent = `${visible}件を表示中`;
      if (empty) empty.hidden = visible !== 0;
    }

    function resetAll() {
      if (search) search.value = '';
      state.kind = 'all';
      state.price = 'all';
      state.use = 'all';
      state.iface = 'all';
      kindChips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.kind === 'all'));
      priceChips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.price === 'all'));
      if (useSelect) useSelect.value = 'all';
      if (interfaceSelect) interfaceSelect.value = 'all';
      apply();
      search?.focus();
    }

    // 項目ページの用途リンクなどから ?kind= / ?use= で来たときに、絞り込みを復元する。
    const params = new URLSearchParams(location.search);
    const pick = (key: string, allowed: Set<string>) => {
      const value = params.get(key);
      return value && allowed.has(value) ? value : null;
    };
    const kindAllowed = new Set(kindChips.map((chip) => chip.dataset.kind ?? ''));
    const priceAllowed = new Set(priceChips.map((chip) => chip.dataset.price ?? ''));
    const useAllowed = new Set([...(useSelect?.options ?? [])].map((option) => option.value));
    const ifaceAllowed = new Set(
      [...(interfaceSelect?.options ?? [])].map((option) => option.value),
    );

    const initialQuery = params.get('q');
    if (initialQuery && search) search.value = initialQuery;
    const initialKind = pick('kind', kindAllowed);
    if (initialKind) {
      state.kind = initialKind;
      kindChips.forEach((chip) =>
        chip.classList.toggle('is-active', chip.dataset.kind === initialKind),
      );
    }
    const initialPrice = pick('price', priceAllowed);
    if (initialPrice) {
      state.price = initialPrice;
      priceChips.forEach((chip) =>
        chip.classList.toggle('is-active', chip.dataset.price === initialPrice),
      );
    }
    const initialUse = pick('use', useAllowed);
    if (initialUse && useSelect) {
      state.use = initialUse;
      useSelect.value = initialUse;
    }
    const initialIface = pick('iface', ifaceAllowed);
    if (initialIface && interfaceSelect) {
      state.iface = initialIface;
      interfaceSelect.value = initialIface;
    }

    search?.addEventListener('input', apply);
    kindChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        state.kind = chip.dataset.kind ?? 'all';
        kindChips.forEach((item) => item.classList.toggle('is-active', item === chip));
        apply();
      });
    });
    priceChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        state.price = chip.dataset.price ?? 'all';
        priceChips.forEach((item) => item.classList.toggle('is-active', item === chip));
        apply();
      });
    });
    useSelect?.addEventListener('change', () => {
      state.use = useSelect.value;
      apply();
    });
    interfaceSelect?.addEventListener('change', () => {
      state.iface = interfaceSelect.value;
      apply();
    });
    reset?.addEventListener('click', resetAll);

    apply();
  </script>
</BaseLayout>
