---
import { diagrams } from '../data/diagrams.ts';

interface Props {
  name: string;
  caption?: string;
  /** 別の章で先に出した図を、この章にもう一度載せるとき true にする。 */
  reprint?: boolean;
}

const { name, caption, reprint = false } = Astro.props;
const diagram = diagrams[name];

if (!diagram) {
  throw new Error(`未登録の図「${name}」です。src/data/diagrams.ts を確認してください。`);
}

// 「概念図」「数値は例示」といった但し書きは diagrams.ts 側に持たせてある。
// 記事から明示された場合だけ、そちらを優先する。
const captionText = caption ?? diagram.caption;

// 見出しの行は図のラベル（図番号・題・操作のヒント）で、本文の重要性を
// 述べるものではない。強い重要性を表す strong は使わず、意味を持たない
// span に class を付けて太字にする。図の説明は figcaption が担う。
---

<figure class="diagram-plate" id={`fig-${name}`}>
  <div class="diagram-plate__head">
    <span class="diagram-plate__no">図 {diagram.number}{reprint ? '（再掲）' : ''}</span>
    <span class="diagram-plate__title">{diagram.title}</span>
    <button class="diagram-plate__zoom" type="button" data-figure-open disabled aria-label={`${diagram.title}を拡大`}>拡大して読む ⤢</button>
  </div>
  <div class="diagram-plate__body">
    <pre class="mermaid">{diagram.code}</pre>
  </div>
  {captionText && <figcaption>{captionText}</figcaption>}
</figure>
