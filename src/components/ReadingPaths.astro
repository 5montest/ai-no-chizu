---
import { getCollection } from 'astro:content';
import { readingPaths } from '../data/reading-paths';
import { withBase } from '../lib/site.mjs';
import { BASE } from '../lib/site.mjs';
import { readingRouteHref } from '../lib/reading-route';
const { detailed = false } = Astro.props;
const entries = await getCollection('chapters');
const index = new Map(entries.map(entry => [entry.id, entry]));
---
<div class:list={['reading-paths', { 'reading-paths--detailed': detailed }]}>
  {readingPaths.map((path, i) => (
    <section class="reading-path" id={path.id} aria-labelledby={`path-${path.id}`}>
      <p class="reading-path__label"><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span> {path.label}</p>
      <h3 id={`path-${path.id}`}>{path.title}</h3>
      <p class="reading-path__duration">{path.pages.length}記事 · 約{path.pages.reduce((sum, page) => sum + (index.get(page.id)?.data.readingMinutes ?? 0), 0)}分</p>
      {detailed && <p>{path.description}</p>}
      <a class="btn reading-path__start" href={readingRouteHref(BASE, path.pages[0].id, path.id)}>このルートを始める →</a>
      {detailed ? <>
        <p class="reading-path__prereq"><span>前提</span>{path.prerequisite}</p>
        <ol class="reading-path__pages">
          {path.pages.map(item => {
            const entry = index.get(item.id);
            if (!entry) throw new Error(`読書ルートの参照先がありません: ${item.id}`);
            return <li><a href={readingRouteHref(BASE, item.id, path.id)}>{entry.data.title}<span>{entry.data.readingMinutes}分</span></a><p>{item.reason}</p>{item.before?.length ? <p class="reading-path__before">先に読むと分かりやすい：{item.before.map((ref, j) => {
              const pre = index.get(ref.id);
              if (!pre) throw new Error(`読書ルートの補助リンク先がありません: ${ref.id}`);
              return <>{j > 0 ? '、' : ''}<a href={withBase(`/chapters/${ref.id}/`)}>{pre.data.title}</a>（{ref.note}）</>;
            })}</p> : null}</li>;
          })}
        </ol>
        <p class="reading-path__outcome">読み終えたら：{path.outcome}</p>
        {path.id === 'decide' && <a href={withBase('/checklist/')}>導入判断の確認シートへ →</a>}
      </> : <>
        <details class="reading-path__details"><summary>学ぶ内容・前提を見る</summary><p>{path.description}</p><p>前提：{path.prerequisite}</p><p>読み終えたら：{path.outcome}</p><a href={withBase(`/start/#${path.id}`)}>読む記事の一覧 →</a></details>
      </>}
    </section>
  ))}
</div>
