---
import curriculum from '../data/curriculum.json';
import { withBase } from '../lib/site.mjs';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const local = path.startsWith(base) ? path.slice(base.length) || '/' : path;

const links = [
  { href: '/start/', label: 'はじめての方へ', match: '/start' },
  { href: '/chapters/', label: '章一覧', match: '/chapters' },
  { href: '/practice/', label: '実践編', match: '/practice' },
  { href: '/zukan/', label: 'AI図鑑', match: '/zukan' },
  { href: '/glossary/', label: '用語辞典', match: '/glossary' },
  { href: '/quiz/', label: 'クイズ', match: '/quiz' },
];

const isCurrent = (match: string) =>
  match === '/' ? local === '/' : local === match || local.startsWith(`${match}/`);

const currentChapter = local.match(/^\/chapters\/(\d{2})\//)?.[1];
const published = curriculum.chapters.filter((c) => c.status === 'published');
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={withBase('/')} aria-label="AIの地図 トップページ">
      <span class="brand__name">AIの地図</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="主要ナビゲーション">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={isCurrent(link.match) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}

      <div class="site-nav__index">
        <p>公開中の章</p>
        {published.map((chapter) => (
          <a
            href={withBase(`/chapters/${chapter.id}/`)}
            aria-current={currentChapter === chapter.id ? 'page' : undefined}
          >
            <span class="no">{chapter.id}</span>
            <span>{chapter.title}</span>
          </a>
        ))}
      </div>
    </nav>

    <div class="header-tools">
      <button class="icon-btn search-btn" type="button" data-search-open aria-label="サイト内検索を開く">
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="8.5" cy="8.5" r="5.2"></circle>
          <path d="m12.6 12.6 4 4"></path>
        </svg>
        <span>検索</span>
        <kbd data-search-key>⌘K</kbd>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="テーマを切り替える">☾</button>
      <button
        class="icon-btn nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="メニューを開く"
      >
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
