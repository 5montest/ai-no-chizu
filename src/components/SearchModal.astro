---
import { withBase } from '../lib/site.mjs';
---

<div
  class="search-overlay"
  data-search-overlay
  data-search-url={withBase('/search.json')}
  aria-hidden="true"
  inert
>
  <div
    class="search-dialog"
    id="site-search-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-title"
  >
    <div class="search-dialog__head">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="8.5" cy="8.5" r="5.2"></circle>
        <path d="m12.6 12.6 4 4"></path>
      </svg>
      <h2 class="sr-only" id="search-title">サイト内検索</h2>
      <input
        type="search"
        placeholder="用語、章、キーワードで探す…"
        aria-labelledby="search-title"
        aria-controls="search-results"
        aria-describedby="search-help"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button class="search-close" type="button" data-search-close aria-label="検索を閉じる">ESC</button>
    </div>
    <p class="sr-only" id="search-help">上下キーで候補を選び、Enterで開きます。Escで閉じます。</p>
    <ul class="search-results" id="search-results" data-search-results></ul>
    <!-- 結果の件数や読み込み状態は、ここだけで読み上げる。
         結果の一覧そのものを live region にすると、1文字打つたびに全件を読み上げてしまう。 -->
    <p class="sr-only" role="status" aria-live="polite" data-search-status></p>
    <div class="search-dialog__foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> 移動</span>
      <span><kbd>Enter</kbd> 開く</span>
      <span><kbd>Esc</kbd> 閉じる</span>
      <span data-search-count></span>
    </div>
  </div>
</div>

<script>
  // 要素の有無は下の if で実行時に確かめる。型の上では「ある」と決めておき、
  // 検索 UI を持たないページでも例外を出さずに素通りさせる。
  const overlay = document.querySelector<HTMLElement>('[data-search-overlay]')!;
  const dialog = overlay.querySelector<HTMLElement>('.search-dialog')!;
  const input = overlay.querySelector<HTMLInputElement>('[data-search-input]')!;
  const resultsEl = overlay.querySelector<HTMLElement>('[data-search-results]')!;
  const countEl = overlay.querySelector<HTMLElement>('[data-search-count]');
  const statusEl = overlay.querySelector<HTMLElement>('[data-search-status]');
  const closeButton = overlay.querySelector<HTMLElement>('[data-search-close]');
  const openButtons = [...document.querySelectorAll<HTMLElement>('[data-search-open]')];

  type SearchItem = {
    title: string;
    url: string;
    description?: string;
    text?: string;
    tags?: string[];
    chapter?: string;
    chapterTitle?: string;
    categoryLabel?: string;
    short?: string;
    vendor?: string;
    kindLabel?: string;
    featured?: boolean;
  };
  type SearchIndex = { pages: SearchItem[]; terms: SearchItem[]; products?: SearchItem[] };
  type SearchResult = SearchItem & { type: 'page' | 'term' | 'product' };

  // ショートカットの表示を OS に合わせる
  const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
  document.querySelectorAll('[data-search-key]').forEach((el) => {
    el.textContent = isMac ? '⌘K' : 'Ctrl K';
  });

  if (overlay && dialog && input && resultsEl) {
    let index: SearchIndex | null = null;
    let loadPromise: Promise<SearchIndex | null> | null = null;
    let loadFailed = false;
    let selected = -1;
    let currentResults: SearchResult[] = [];
    let lastFocused: Element | null = null;

    const normalize = (value: unknown) =>
      String(value ?? '')
        .normalize('NFKC')
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();

    const isOpen = () => overlay.classList.contains('is-open');

    function setStatus(text: string) {
      if (statusEl) statusEl.textContent = text;
    }

    /**
     * 読み込みに失敗したときは index を空で確定させず、次回もう一度取りに行く。
     * 空のまま固定すると、通信が復帰しても再試行できなくなる。
     */
    function ensureIndex() {
      if (index) return Promise.resolve(index);
      if (loadPromise) return loadPromise;

      loadFailed = false;
      const url = overlay.getAttribute('data-search-url');
      if (!url) {
        console.error('検索インデックスの URL が指定されていません');
        loadFailed = true;
        return Promise.resolve(null);
      }
      loadPromise = fetch(url, { headers: { accept: 'application/json' } })
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          if (!Array.isArray(data?.pages) || !Array.isArray(data?.terms)) {
            throw new Error('検索インデックスの形式が想定と違います');
          }
          index = data;
          loadFailed = false;
          return index;
        })
        .catch((error) => {
          console.error('検索インデックスを読み込めませんでした', error);
          loadFailed = true;
          // 失敗した結果は覚えない。次の open や再試行で取り直す。
          loadPromise = null;
          return null;
        });

      return loadPromise;
    }

    function scoreItem(item: SearchResult, q: string) {
      let score = 0;
      const title = normalize(item.title);
      const desc = normalize(item.description || '');
      const body = normalize(item.text || '');
      const tags = normalize((item.tags || []).join(' '));

      if (title === q) score += 120;
      else if (title.startsWith(q)) score += 80;
      else if (title.includes(q)) score += 55;

      if (tags.includes(q)) score += 35;
      if (desc.includes(q)) score += 25;
      if (body.includes(q)) score += 10;

      // 章番号や短い語でも見つけやすくする
      if (item.chapter && q.length <= 3 && normalize(item.chapter).includes(q)) score += 30;
      return score;
    }

    function search(query: string): SearchResult[] {
      if (!index) return [];
      const q = normalize(query);
      const all: SearchResult[] = [
        ...index.pages.map((p): SearchResult => ({ ...p, type: 'page' })),
        ...index.terms.map((t): SearchResult => ({ ...t, type: 'term' })),
        ...(index.products ?? []).map((p): SearchResult => ({ ...p, type: 'product' })),
      ];
      if (!q) {
        return all.filter((item) => item.featured).slice(0, 8);
      }
      return all
        .map((item) => ({ item, score: scoreItem(item, q) }))
        .filter(({ score }) => score > 0)
        .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title, 'ja'))
        .slice(0, 14)
        .map(({ item }) => item);
    }

    function makeResult(item: SearchResult, i: number) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'search-result';
      a.href = item.url;
      a.dataset.index = String(i);

      const type = document.createElement('span');
      type.className = 'search-result__type';
      type.textContent =
        item.type === 'term' ? '用語' : item.type === 'product' ? '製品' : 'ページ';

      const text = document.createElement('span');
      const title = document.createElement('span');
      title.className = 'search-result__title';
      title.textContent = item.title;
      const meta = document.createElement('span');
      meta.className = 'search-result__meta';
      meta.textContent =
        item.type === 'term'
          ? `${item.categoryLabel || ''}　${item.short || ''}`
          : item.type === 'product'
            ? `${item.vendor || ''}　${item.kindLabel || ''}`
            : `第${item.chapter}章 ${item.chapterTitle || ''}`;
      text.append(title, meta);

      a.append(type, text);
      li.append(a);
      return li;
    }

    /** 一覧を差し替える。results が null のときは「まだ出せない」状態を出す。 */
    function renderMessage(message: string, { retry = false } = {}) {
      currentResults = [];
      selected = -1;
      resultsEl.replaceChildren();
      const li = document.createElement('li');
      li.className = 'search-empty';
      if (retry) {
        const p = document.createElement('p');
        p.className = 'search-empty__text';
        p.textContent = message;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'search-retry';
        button.textContent = '再読み込みする';
        button.addEventListener('click', () => {
          // 失敗の記録を消してから呼ぶ。消さないと、また失敗の表示に戻ってしまう。
          loadFailed = false;
          loadPromise = null;
          applySearch();
        });
        li.append(p, button);
      } else {
        li.textContent = message;
      }
      resultsEl.append(li);
      if (countEl) countEl.textContent = '';
    }

    function render(items: SearchResult[]) {
      currentResults = items;
      selected = -1;
      resultsEl.replaceChildren();

      if (!items.length) {
        const hasQuery = normalize(input.value) !== '';
        renderMessage(
          hasQuery
            ? '一致する項目が見つかりませんでした。別の言葉で試してください。'
            : 'まだ何も入力されていません。',
        );
        if (countEl) countEl.textContent = '';
        setStatus(hasQuery ? '一致する項目がありません' : '');
        return;
      }

      items.forEach((item, i) => resultsEl.append(makeResult(item, i)));
      if (countEl) countEl.textContent = `${items.length}件`;
      setStatus(`${items.length}件見つかりました`);
    }

    /**
     * 今の入力と、今の読み込み状態から表示を作り直す。
     * 読み込み中に入力された語も、ここを通ることで反映される。
     */
    function applySearch() {
      if (loadFailed) {
        renderMessage('検索インデックスを読み込めませんでした。', { retry: true });
        setStatus('読み込みに失敗しました');
        return;
      }
      if (!index) {
        renderMessage('検索の準備をしています…');
        setStatus('読み込み中です');
        // 読み込みが終わったら、そのときの入力で描き直す。
        ensureIndex().then(() => {
          if (isOpen()) applySearch();
        });
        return;
      }
      render(search(input.value));
    }

    function updateSelection(next: number) {
      if (!currentResults.length) return;
      const links = [...resultsEl.querySelectorAll('.search-result')];
      links.forEach((el) => el.classList.remove('is-selected'));
      selected = (next + links.length) % links.length;
      const link = links[selected];
      link.classList.add('is-selected');
      link.scrollIntoView({ block: 'nearest' });
      setStatus(
        `${currentResults.length}件中${selected + 1}件目、${currentResults[selected].title}`,
      );
    }

    function setExpanded(value: boolean) {
      openButtons.forEach((button) => button.setAttribute('aria-expanded', String(value)));
    }

    function open() {
      lastFocused = document.activeElement;
      overlay.classList.add('is-open');
      overlay.removeAttribute('inert');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('no-scroll');
      setExpanded(true);

      // inert を外した直後に移す。待ち時間を置くと、その間に別の場所へ
      // フォーカスが動いたときに取り戻してしまう。
      requestAnimationFrame(() => {
        if (!isOpen()) return;
        input.focus();
        input.select();
        applySearch();
      });
    }

    function close() {
      if (!isOpen()) return;
      overlay.classList.remove('is-open');
      overlay.setAttribute('inert', '');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('no-scroll');
      setExpanded(false);
      setStatus('');

      // 開く前に focus していた要素が消えていることもある。
      if (lastFocused instanceof HTMLElement && lastFocused.isConnected) {
        lastFocused.focus();
      } else {
        openButtons[0]?.focus();
      }
    }

    // 開いている間、Tab がダイアログの外へ抜けないようにする。
    function trapTab(event: KeyboardEvent) {
      if (event.key !== 'Tab') return;
      const focusable = [
        ...dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled])'),
      ].filter((el) => el.offsetParent !== null || el === document.activeElement);
      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    openButtons.forEach((button) => {
      button.setAttribute('aria-controls', 'site-search-dialog');
      button.setAttribute('aria-expanded', 'false');
      button.addEventListener('click', open);
    });

    closeButton?.addEventListener('click', close);
    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) close();
    });

    overlay.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      trapTab(event);
    });

    input.addEventListener('input', () => {
      applySearch();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        updateSelection(selected + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        updateSelection(selected - 1);
      } else if (event.key === 'Enter') {
        const link = resultsEl.querySelectorAll('.search-result')[selected >= 0 ? selected : 0];
        if (link instanceof HTMLAnchorElement) {
          event.preventDefault();
          link.click();
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (isOpen()) close();
        else open();
      } else if (event.key === 'Escape' && isOpen()) {
        // フォーカスがダイアログの外にある場合の保険。close() は二重に呼んでも安全。
        close();
      }
    });
  }
</script>
