---
import { withBase } from '../lib/site.mjs';
---

<div
  class="search-overlay"
  data-search-overlay
  data-search-url={withBase('/search.json')}
  aria-hidden="true"
  inert
>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <div class="search-dialog__head">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="8.5" cy="8.5" r="5.2"></circle>
        <path d="m12.6 12.6 4 4"></path>
      </svg>
      <h2 class="sr-only" id="search-title">サイト内検索</h2>
      <input
        type="search"
        placeholder="用語、章、キーワードで探す…"
        aria-label="サイト内を検索"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button class="search-close" type="button" data-search-close aria-label="検索を閉じる">ESC</button>
    </div>
    <ul class="search-results" data-search-results aria-live="polite"></ul>
    <div class="search-dialog__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 移動</span>
      <span><kbd>Enter</kbd> 開く</span>
      <span><kbd>Esc</kbd> 閉じる</span>
      <span data-search-count></span>
    </div>
  </div>
</div>

<script>
  const overlay = document.querySelector('[data-search-overlay]');
  const input = overlay?.querySelector('[data-search-input]');
  const resultsEl = overlay?.querySelector('[data-search-results]');
  const countEl = overlay?.querySelector('[data-search-count]');
  const openButtons = [...document.querySelectorAll('[data-search-open]')];
  const closeButton = overlay?.querySelector('[data-search-close]');

  let index = null;
  let loading = false;
  let selected = -1;
  let currentResults = [];
  let lastFocused = null;

  // ショートカットの表示を OS に合わせる
  const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
  document.querySelectorAll('[data-search-key]').forEach((el) => {
    el.textContent = isMac ? '⌘K' : 'Ctrl K';
  });

  const normalize = (value) =>
    String(value ?? '')
      .normalize('NFKC')
      .toLowerCase()
      .replace(/\s+/g, ' ')
      .trim();

  async function ensureIndex() {
    if (index || loading) return index;
    loading = true;
    try {
      const url = overlay?.getAttribute('data-search-url');
      const res = await fetch(url, { headers: { accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      index = await res.json();
    } catch (error) {
      console.error('検索インデックスを読み込めませんでした', error);
      index = { pages: [], terms: [] };
    } finally {
      loading = false;
    }
    return index;
  }

  function scoreItem(item, q) {
    let score = 0;
    const title = normalize(item.title);
    const desc = normalize(item.description || '');
    const body = normalize(item.text || '');
    const tags = normalize((item.tags || []).join(' '));

    if (title === q) score += 120;
    else if (title.startsWith(q)) score += 80;
    else if (title.includes(q)) score += 55;

    if (tags.includes(q)) score += 35;
    if (desc.includes(q)) score += 25;
    if (body.includes(q)) score += 10;

    // 章番号や短い語でも見つけやすくする
    if (item.chapter && q.length <= 3 && normalize(item.chapter).includes(q)) score += 30;
    return score;
  }

  function search(query) {
    if (!index) return [];
    const q = normalize(query);
    const all = [
      ...index.pages.map((p) => ({ ...p, type: 'page' })),
      ...index.terms.map((t) => ({ ...t, type: 'term' })),
    ];
    if (!q) {
      return all.filter((item) => item.featured).slice(0, 8);
    }
    return all
      .map((item) => ({ item, score: scoreItem(item, q) }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title, 'ja'))
      .slice(0, 14)
      .map(({ item }) => item);
  }

  function makeResult(item, i) {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.className = 'search-result';
    a.href = item.url;
    a.dataset.index = String(i);

    const type = document.createElement('span');
    type.className = 'search-result__type';
    type.textContent = item.type === 'term' ? '用語' : 'ページ';

    const text = document.createElement('span');
    const title = document.createElement('span');
    title.className = 'search-result__title';
    title.textContent = item.title;
    const meta = document.createElement('span');
    meta.className = 'search-result__meta';
    meta.textContent =
      item.type === 'term'
        ? `${item.categoryLabel || ''}　${item.short || ''}`
        : `第${item.chapter}章 ${item.chapterTitle || ''}`;
    text.append(title, meta);

    a.append(type, text);
    li.append(a);
    return li;
  }

  function render(items) {
    currentResults = items;
    selected = -1;
    if (!resultsEl) return;
    resultsEl.replaceChildren();

    if (!items.length) {
      const li = document.createElement('li');
      li.className = 'search-empty';
      li.textContent = input?.value
        ? '一致する項目が見つかりませんでした。別の言葉で試してください。'
        : '読み込み中です…';
      resultsEl.append(li);
      if (countEl) countEl.textContent = '';
      return;
    }

    items.forEach((item, i) => resultsEl.append(makeResult(item, i)));
    if (countEl) countEl.textContent = `${items.length}件`;
  }

  function updateSelection(next) {
    if (!currentResults.length) return;
    const links = [...resultsEl.querySelectorAll('.search-result')];
    links.forEach((el) => el.classList.remove('is-selected'));
    selected = (next + links.length) % links.length;
    const link = links[selected];
    link.classList.add('is-selected');
    link.scrollIntoView({ block: 'nearest' });
  }

  async function open() {
    if (!overlay) return;
    lastFocused = document.activeElement;
    overlay.classList.add('is-open');
    overlay.removeAttribute('inert');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('no-scroll');
    window.setTimeout(() => input?.focus(), 30);
    await ensureIndex();
    if (!input?.value) render(search(''));
  }

  function close() {
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('inert', '');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('no-scroll');
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  }

  openButtons.forEach((btn) => btn.addEventListener('click', open));
  closeButton?.addEventListener('click', close);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) close();
  });

  input?.addEventListener('input', () => {
    render(search(input.value));
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      updateSelection(selected + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      updateSelection(selected - 1);
    } else if (event.key === 'Enter') {
      const link = resultsEl?.querySelectorAll('.search-result')[selected >= 0 ? selected : 0];
      if (link instanceof HTMLAnchorElement) {
        event.preventDefault();
        link.click();
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (overlay?.classList.contains('is-open')) close();
      else open();
    } else if (event.key === 'Escape' && overlay?.classList.contains('is-open')) {
      close();
    }
  });
</script>
