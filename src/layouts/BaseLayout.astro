---
import '../styles/global.css';
import '../styles/learning-ux.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import FigureViewer from '../components/FigureViewer.astro';
import glossary from '../data/glossary.json';
import { SITE, withBase } from '../lib/site.mjs';

const {
  title,
  description = SITE.description,
  noindex = false,
  bodyClass = '',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
// 公開先は astro.config.mjs の site が決める。未設定の開発時だけ、いま開いている URL を使う。
const canonical = new URL(Astro.url.pathname.replace(/\/404\/?$/, '/404.html'), Astro.site ?? Astro.url).href;
// 共有画像は GitHub Pages のサブパスも含めた絶対URLにする。ルート直下を指さない。
const ogImage = new URL(withBase('/og-image.png'), Astro.site ?? Astro.url).href;
const ogImageAlt = 'AIの地図。AI・LLMの原理から、製品選びと実装まで。';
const tips = Object.fromEntries(glossary.terms.map((t) => [t.slug, t.short]));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141619" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('ai-map-theme');
          const theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          /* localStorage が使えない環境では CSS の prefers-color-scheme に任せる */
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="read-progress" data-read-progress hidden><span data-read-progress-bar></span></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <button type="button" class="mobile-toc" data-mobile-toc aria-haspopup="dialog" aria-controls="mobile-toc-dialog">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      目次
    </button>
    <dialog class="mobile-toc-dialog" id="mobile-toc-dialog" aria-labelledby="mobile-toc-title">
      <div class="mobile-toc-dialog__head">
        <h2 id="mobile-toc-title">このページの目次</h2>
        <form method="dialog"><button class="mobile-toc-dialog__close">閉じる</button></form>
      </div>
      <div class="mobile-toc-dialog__body"></div>
    </dialog>
    <SearchModal />
    <FigureViewer />
    <script type="application/json" id="glossary-data" set:html={JSON.stringify(tips)}></script>
    <script>
      // --- 用語ツールチップ -------------------------------------------------
      const glossaryData = (() => {
        try {
          return JSON.parse(document.getElementById('glossary-data')?.textContent || '{}');
        } catch {
          return {};
        }
      })();

      // 右端に近い用語では吹き出しが画面の外へはみ出し、ページごと横に広がる。
      // はみ出すときだけ左向きに付け替える。
      const placeTip = (link: HTMLElement) => {
        const tip = link.querySelector('.gloss-tip');
        if (!tip) return;
        link.classList.remove('gloss-tip-left');
        const room = document.documentElement.clientWidth - tip.getBoundingClientRect().right;
        if (room < 8) link.classList.add('gloss-tip-left');
      };

      for (const link of document.querySelectorAll<HTMLElement>('.gloss-link[data-gloss]')) {
        const slug = link.dataset.gloss;
        const short = slug ? glossaryData[slug] : '';
        if (!short || link.querySelector('.gloss-tip')) continue;
        const tip = document.createElement('span');
        tip.className = 'gloss-tip';
        tip.setAttribute('aria-hidden', 'true');
        tip.textContent = short;
        link.appendChild(tip);
        link.addEventListener('pointerenter', () => placeTip(link));
        link.addEventListener('focusin', () => placeTip(link));
      }

      // 出していない吹き出しも幅を持つので、初回と幅が変わったときに全部そろえる。
      const placeAllTips = () => {
        for (const tip of document.querySelectorAll('.gloss-link[data-gloss] > .gloss-tip')) {
          if (tip.parentElement) placeTip(tip.parentElement);
        }
      };
      placeAllTips();
      let tipTicking = false;
      window.addEventListener(
        'resize',
        () => {
          if (tipTicking) return;
          tipTicking = true;
          requestAnimationFrame(() => {
            tipTicking = false;
            placeAllTips();
          });
        },
        { passive: true },
      );

      // --- テーマ切り替え ---------------------------------------------------
      const themeButton = document.querySelector('[data-theme-toggle]');
      const paintThemeButton = () => {
        if (!themeButton) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton.textContent = dark ? '☀' : '☾';
        themeButton.setAttribute(
          'aria-label',
          dark ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える',
        );
        themeButton.setAttribute('title', dark ? 'ライトテーマ' : 'ダークテーマ');
      };
      paintThemeButton();
      themeButton?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('ai-map-theme', next);
        } catch {
          /* 保存できなくても表示は切り替える */
        }
        paintThemeButton();
        document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });

      // --- モバイルナビ -----------------------------------------------------
      const navToggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
      const siteNav = document.getElementById('site-nav');
      const setNav = (open: boolean) => {
        if (!siteNav || !navToggle) return;
        siteNav.classList.toggle('is-open', open);
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      };
      navToggle?.addEventListener('click', () => {
        setNav(!siteNav?.classList.contains('is-open'));
      });
      siteNav?.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) setNav(false);
      });
      // 開いたまま閉じられないと行き止まりになる。外側のタップと Esc で閉じる。
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !siteNav?.classList.contains('is-open')) return;
        setNav(false);
        if (navToggle instanceof HTMLElement) navToggle.focus();
      });
      document.addEventListener('click', (event) => {
        if (!siteNav?.classList.contains('is-open')) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (siteNav.contains(target) || navToggle?.contains(target)) return;
        setNav(false);
      });

      // --- 目次の現在位置 ---------------------------------------------------
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')];
      if (tocLinks.length) {
        const headings = tocLinks
          .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
          .filter((heading): heading is HTMLElement => Boolean(heading));
        let ticking = false;
        const syncToc = () => {
          ticking = false;
          let current = headings[0];
          for (const h of headings) {
            if (h.getClientRects().length && h.getBoundingClientRect().top <= 140) current = h;
          }
          for (const a of tocLinks) {
            // a.hash は日本語を見出し ID と違う形に符号化するので、ID 側にそろえる。
            const active = current && decodeURIComponent(a.hash.slice(1)) === current.id;
            a.classList.toggle('is-active', Boolean(active));
            if (active) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          }
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(syncToc);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        syncToc();
      }

      // 目次や検索結果が折りたたみ内を指す場合は、対象を開いてから移動する。
      const revealHash = () => {
        let id = '';
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        let parent = target.parentElement;
        let revealed = false;
        while (parent) {
          if (parent instanceof HTMLDetailsElement && !parent.open) { parent.open = true; revealed = true; }
          parent = parent.parentElement;
        }
        if (revealed) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      };
      window.addEventListener('hashchange', revealHash);
      document.addEventListener('click', event => {
        const link = (event.target as Element)?.closest<HTMLAnchorElement>('a[href*="#"]');
        if (link && link.pathname === location.pathname && link.hash === location.hash) revealHash();
      });
      revealHash();

      // --- 読書の現在地 -----------------------------------------------------
      // 長い記事で「あとどれくらいで読み終わるか」が分かるよう、上端に細い線を出す。
      const progressWrap = document.querySelector<HTMLElement>('[data-read-progress]');
      const progressBar = document.querySelector<HTMLElement>('[data-read-progress-bar]');
      if (progressWrap && progressBar && document.querySelector('.article-body')) {
        progressWrap.hidden = false;
        let progressTick = false;
        const paintProgress = () => {
          progressTick = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progressBar.style.width = `${(ratio * 100).toFixed(2)}%`;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (progressTick) return;
            progressTick = true;
            requestAnimationFrame(paintProgress);
          },
          { passive: true },
        );
        window.addEventListener('resize', paintProgress);
        paintProgress();
      }

      // --- モバイル用の目次 -------------------------------------------------
      // 画面幅が狭いと目次は上端の横並びに変わり、読み進めると画面外へ消える。
      // 読み進めた後にだけ固定ボタンを出し、ダイアログで同じ目次を開き直せるようにする。
      const tocSource = document.querySelector<HTMLOListElement>('.toc ol');
      const tocButton = document.querySelector<HTMLButtonElement>('[data-mobile-toc]');
      const tocDialog = document.getElementById('mobile-toc-dialog') as HTMLDialogElement | null;
      const tocBody = tocDialog?.querySelector<HTMLElement>('.mobile-toc-dialog__body');
      if (tocSource && tocButton && tocDialog && tocBody) {
        if (!tocBody.childElementCount) tocBody.append(tocSource.cloneNode(true));
        const mobileTocQuery = window.matchMedia('(max-width: 899px)');
        let tocTick = false;
        const syncTocButton = () => {
          tocTick = false;
          tocButton.dataset.visible = String(mobileTocQuery.matches && window.scrollY > 560);
        };
        window.addEventListener(
          'scroll',
          () => {
            if (tocTick) return;
            tocTick = true;
            requestAnimationFrame(syncTocButton);
          },
          { passive: true },
        );
        mobileTocQuery.addEventListener?.('change', syncTocButton);
        syncTocButton();
        tocButton.addEventListener('click', () => tocDialog.showModal());
        tocDialog.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          // 背景（dialog 自身）のクリックと、項目の選択で閉じる。
          if (target === tocDialog || target.closest('a')) tocDialog.close();
        });
      }

      // --- コードブロックの操作 ---------------------------------------------
      // 言語名とコピーを添える。CLI の手順を写して実行する読者のため、
      // 行の折り返しや選択に頼らず1操作でコピーできるようにする。
      for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
        if (pre.closest('.code-block')) continue;
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        const head = document.createElement('div');
        head.className = 'code-block__head';
        const lang = document.createElement('span');
        lang.className = 'code-block__lang';
        lang.textContent = pre.dataset.language ?? 'text';
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'code-block__copy';
        copy.textContent = 'コピー';
        copy.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            // クリップボードが使えない環境では選択に切り替える。
            copy.textContent = '選択しました';
            const range = document.createRange();
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            return;
          }
          copy.textContent = 'コピーしました';
          window.setTimeout(() => {
            copy.textContent = 'コピー';
          }, 1600);
        });
        head.append(lang, copy);
        pre.replaceWith(wrap);
        wrap.append(head, pre);
      }

      // --- Mermaid ----------------------------------------------------------
      const mermaidNodes = [...document.querySelectorAll<HTMLElement>('.mermaid')];
      if (mermaidNodes.length) {
        const palettes = {
          light: {
            primaryColor: '#eef4fa',
            primaryTextColor: '#16181c',
            primaryBorderColor: '#a9c4de',
            secondaryColor: '#f4f5f6',
            tertiaryColor: '#ffffff',
            lineColor: '#7b8794',
            textColor: '#16181c',
            clusterBkg: '#f4f5f6',
            clusterBorder: '#d5d9de',
            edgeLabelBackground: '#fbfbfa',
          },
          dark: {
            primaryColor: '#1e2833',
            primaryTextColor: '#e7e9ec',
            primaryBorderColor: '#46586b',
            secondaryColor: '#1a1d21',
            tertiaryColor: '#171a1e',
            lineColor: '#8b96a3',
            textColor: '#e7e9ec',
            clusterBkg: '#1a1d21',
            clusterBorder: '#3a414a',
            edgeLabelBackground: '#141619',
          },
        };

        for (const node of mermaidNodes) {
          node.dataset.src = node.textContent ?? '';
        }

        // 図のあるページでだけ読み込む（全ページのバンドルに載せない）。
        let mermaidApi: (typeof import('mermaid'))['default'] | null = null;
        const renderDiagrams = async () => {
          if (!mermaidApi) {
            mermaidApi = (await import('mermaid')).default;
          }
          const mode = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
          mermaidApi.initialize({
            startOnLoad: false,
            theme: 'base',
            securityLevel: 'loose',
            fontFamily:
              '"Hiragino Sans", "Yu Gothic", "Noto Sans JP", system-ui, sans-serif',
            themeVariables: { ...palettes[mode], fontSize: '14px' },
            flowchart: { htmlLabels: true, curve: 'basis', padding: 14, nodeSpacing: 34, rankSpacing: 48 },
          });
          for (const node of mermaidNodes) {
            node.removeAttribute('data-processed');
            node.textContent = node.dataset.src ?? '';
          }
          await mermaidApi.run({ nodes: mermaidNodes });
          fitDiagrams();
        };

        // 図の読みやすさを優先して大きさを決める。
        // 横長の図は本文幅に縮めるとラベルが8px前後まで潰れるため、
        // デスクトップでは原寸の8割までしか縮めず、はみ出した分は枠の中で横に動かす。
        // スマートフォンは全体が見えることを優先し、細部は拡大ビューアーで読む。
        const fitDiagrams = () => {
          const narrow = window.innerWidth < 640;
          for (const node of mermaidNodes) {
            const svg = node.querySelector<SVGSVGElement>('svg');
            if (!svg) continue;
            const natural = svg.viewBox?.baseVal?.width ?? 0;
            const contentWidth = node.clientWidth;
            const plate = node.closest('.diagram-plate');
            if (natural && contentWidth) {
              const target =
                natural > contentWidth
                  ? narrow
                    ? contentWidth
                    : Math.min(natural, Math.max(contentWidth, Math.round(natural * 0.82)))
                  : Math.min(contentWidth, Math.round(natural * 1.15));
              svg.style.maxWidth = 'none';
              svg.style.width = `${target}px`;
              node.style.textAlign = '';
              plate?.classList.toggle('is-scrollable', target > contentWidth + 8);
            } else {
              svg.style.maxWidth = '';
              svg.style.width = '';
              node.style.textAlign = '';
              plate?.classList.remove('is-scrollable');
            }
            const button = plate?.querySelector<HTMLButtonElement>('[data-figure-open]');
            if (button) button.disabled = false;
          }
        };

        let fitTimer = 0;
        window.addEventListener('resize', () => {
          window.clearTimeout(fitTimer);
          fitTimer = window.setTimeout(fitDiagrams, 200);
        });

        (async () => {
          try {
            await renderDiagrams();
          } catch (error) {
            console.error('Mermaid の描画に失敗しました', error);
            for (const node of mermaidNodes) {
              if (!node.hasAttribute('data-processed')) {
                node.setAttribute('data-processed', 'error');
              }
            }
          }
        })();

        document.addEventListener('toggle', event => {
          if (event.target instanceof HTMLDetailsElement && event.target.open) requestAnimationFrame(fitDiagrams);
        }, true);

        document.addEventListener('themechange', () => {
          const drawn = mermaidNodes.map((node) => node.innerHTML);
          renderDiagrams().catch((error) => {
            console.error('Mermaid の再描画に失敗しました', error);
            mermaidNodes.forEach((node, index) => {
              node.innerHTML = drawn[index];
            });
          });
        });
      }
    </script>
  </body>
</html>
